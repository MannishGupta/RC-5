{
  "name": "arthsathi/resource-centre",
  "description": "Resource Centre (RC) multi-tenant PHP application",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "autoload": {
    "classmap": ["core/", "app/"]
  },
  "scripts": {
    "stan": "phpstan analyse --memory-limit=512M",
    "cs": "phpcs",
    "lint": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "config": {
    "sort-packages": true
  }
}
