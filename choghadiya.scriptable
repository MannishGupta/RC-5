{
  "always_run_in_app": false,
  "icon": {
    "color": "brown",
    "glyph": "magic"
  },
  "name": "choghadiya",
  "script": "// Version: 8.3.4\n// Fix: Vikram/Shaka Samvat pre-Chaitra rollover (isPreChaitra)\n// Fix: Hindu month (rashiIdx + 1) % 12\n// Parity: matches RC choghadiya.php API version 8.3.4 (Rahu 0-based segment, Vaar Vela, goodWindows clash filter)\n// तिथि + राहु काल + शुभ समय — Scriptable (iOS 17.2+ & iPadOS All-Sizes Optimized) विजेट\n// Fix: Conflict resolution when Rahu Kaal / Vaar Vela overlaps with an auspicious Choghadiya (e.g. Friday 3rd slot)\n// Dynamic Vedic Sankalp Card with Complete Family (मनीष गुप्ता, अंजलि गुप्ता, आर्य गुप्ता, अलीशा गुप्ता, अशोक गुप्ता, हेमलता गुप्ता, आशीष गुप्ता, दीपिका गुप्ता एवं समस्त परिवार)\n// Sreshtha Vihar #118, Shera Waali Mata, Garg Gotra\n// Default Language: Hindi (\"hi\") with clear English numerals\n// Regional Setting: Asia/Kolkata (IST, UTC+05:30)\n// Default Fallback Location: Simco Residency, East Delhi (28.65944° N, 77.31705° E)\n// Developed by Arthsathi Limited · www.arthsathi.com\n\n// ===================== SETTINGS / CONFIG =====================\nconst API_ENDPOINT = \"https://rc.arthsathi.com/choghadiya.php\";\nconst API_TIMEOUT_SEC = 6;\n\nconst DEFAULT_LANGUAGE = \"hi\";\nconst TIMEZONE = \"Asia/Kolkata\";\n\nconst FALLBACK_LOCATION = {\n  lat: 28.65944,\n  lon: 77.31705,\n  place: \"Simco Residency, East Delhi\",\n  placeHi: \"सिमको रेजिडेंसी, पूर्वी दिल्ली\"\n};\nconst FIXED_LOCATION = null;\n\nconst DEV_COMPANY = \"Arthsathi Limited\";\nconst DEV_SITE = \"https://www.arthsathi.com\";\nconst CUSTOM_LOGO_URL = \"https://rc.arthsathi.com/favicon-512.png\";\nconst LOGO_ICONS = [\n  CUSTOM_LOGO_URL,\n  \"https://rc.arthsathi.com/apple-touch-icon.png\",\n  \"https://rc.arthsathi.com/favicon.png\",\n  \"https://rc.arthsathi.com/favicon.ico\"\n];\n\n// ===================== PANCHANG, FESTIVALS & SANKALP ENGINE =====================\nfunction panchangLib(langCode) {\n  const LANG = /^en/i.test(langCode || \"\") ? \"en-IN\" : \"hi\";\n  const RAD = Math.PI / 180, DAY_MS = 86400000, J1970 = 2440588, J2000 = 2451545;\n  const IST_MS = 330 * 60000;\n  const mod360 = x => ((x % 360) + 360) % 360;\n\n  function istParts(d) {\n    const u = new Date(d.getTime() + IST_MS);\n    return {\n      year: u.getUTCFullYear(),\n      month: u.getUTCMonth(),\n      date: u.getUTCDate(),\n      day: u.getUTCDay(),\n      hours: u.getUTCHours(),\n      minutes: u.getUTCMinutes(),\n      seconds: u.getUTCSeconds()\n    };\n  }\n\n  function fromIST(y, m, d, h = 0, min = 0) {\n    return new Date(Date.UTC(y, m, d, h, min, 0) - IST_MS);\n  }\n\n  function isoDateIST(d) {\n    const p = istParts(d);\n    const pad = n => String(n).padStart(2, \"0\");\n    return p.year + \"-\" + pad(p.month + 1) + \"-\" + pad(p.date);\n  }\n\n  function normalizeChoghadiyaKey(raw) {\n    if (!raw) return null;\n    const s = String(raw).trim().toLowerCase();\n    if (s.indexOf(\"amrit\") !== -1 || s.indexOf(\"अमृत\") !== -1) return \"Amrit\";\n    if (s.indexOf(\"shubh\") !== -1 || s.indexOf(\"शुभ\") !== -1) return \"Shubh\";\n    if (s.indexOf(\"labh\") !== -1 || s.indexOf(\"लाभ\") !== -1) return \"Labh\";\n    if (s.indexOf(\"char\") !== -1 || s.indexOf(\"चर\") !== -1) return \"Char\";\n    if (s.indexOf(\"rog\") !== -1 || s.indexOf(\"रोग\") !== -1) return \"Rog\";\n    if (s.indexOf(\"kaal\") !== -1 || s.indexOf(\"kala\") !== -1 || s.indexOf(\"काल\") !== -1) return \"Kaal\";\n    if (s.indexOf(\"udveg\") !== -1 || s.indexOf(\"उद्वेग\") !== -1) return \"Udveg\";\n    return null;\n  }\n\n  function parseApiTime(val, refDate) {\n    if (!val && val !== 0) return null;\n    if (val instanceof Date) return isNaN(val.getTime()) ? null : val;\n    if (typeof val === \"number\") {\n      return new Date(val < 1e12 ? val * 1000 : val);\n    }\n    const str = String(val).trim();\n    if (!str) return null;\n    if (/^\\d{4}-\\d{2}-\\d{2}/.test(str)) {\n      const d = new Date(str);\n      if (!isNaN(d.getTime())) return d;\n    }\n    const m = str.match(/^(\\d{1,2}):(\\d{2})(?::(\\d{2}))?\\s*(am|pm)?$/i);\n    if (m && refDate) {\n      const rp = istParts(refDate);\n      let hh = parseInt(m[1], 10);\n      const mm = parseInt(m[2], 10);\n      const ampm = (m[4] || \"\").toLowerCase();\n      if (ampm === \"pm\" && hh < 12) hh += 12;\n      if (ampm === \"am\" && hh === 12) hh = 0;\n      return fromIST(rp.year, rp.month, rp.date, hh, mm);\n    }\n    const fallback = new Date(str);\n    return isNaN(fallback.getTime()) ? null : fallback;\n  }\n\n  const SANSKRIT_VAAR = [\"भानु\", \"सोम\", \"भौम\", \"सौम्य (बुध)\", \"बृहस्पति (गुरु)\", \"भृगु (शुक्र)\", \"स्थिर (शनि)\"];\n  const SANSKRIT_TITHI = [\n    \"प्रतिपदायां\", \"द्वितीयायां\", \"तृतीयायां\", \"चतुर्थ्यां\", \"पञ्चम्यां\", \"षष्ठ्यां\", \"सप्तम्यां\",\n    \"अष्टम्यां\", \"नवम्यां\", \"दशम्यां\", \"एकादश्यां\", \"द्वादश्यां\", \"त्रयोदश्यां\", \"चतुर्दश्यां\"\n  ];\n  const SANSKRIT_MONTHS = [\n    \"चैत्र\", \"वैशाख\", \"ज्येष्ठ\", \"आषाढ\", \"श्रावण\", \"भाद्रपद\",\n    \"आश्विन\", \"कार्तिक\", \"मार्गशीर्ष\", \"पौष\", \"माघ\", \"फाल्गुन\"\n  ];\n  const SANSKRIT_RASHI = [\"मेष\", \"वृषभ\", \"मिथुन\", \"कर्क\", \"सिंह\", \"कन्या\", \"तुला\", \"वृश्चिक\", \"धनु\", \"मकर\", \"कुम्भ\", \"मीन\"];\n  const NAKSHATRA_NAMES = [\n    \"अश्विनी\", \"भरणी\", \"कृत्तिका\", \"रोहिणी\", \"मृगशिरा\", \"आर्द्रा\", \"पुनर्वसु\", \"पुष्य\", \"आश्लेषा\",\n    \"मघा\", \"पूर्वाफाल्गुनी\", \"उत्तराफाल्गुनी\", \"हस्त\", \"चित्रा\", \"स्वाती\", \"विशाखा\", \"अनुराधा\", \"ज्येष्ठा\",\n    \"मूल\", \"पूर्वाषाढ़ा\", \"उत्तराषाढ़ा\", \"श्रवण\", \"धनिष्ठा\", \"शतभिषा\", \"पूर्वाभाद्रपद\", \"उत्तराभाद्रपद\", \"रेवती\"\n  ];\n  const YOGA_NAMES = [\n    \"विष्कम्भ\", \"प्रीति\", \"आयुष्मान्\", \"सौभाग्य\", \"शोभन\", \"अतिगण्ड\", \"सुकर्मा\", \"धृति\", \"शूल\",\n    \"गण्ड\", \"वृद्धि\", \"ध्रुव\", \"व्याघात\", \"हर्षण\", \"वज्र\", \"सिद्धि\", \"व्यतीपात\", \"वरीयान्\",\n    \"परिघ\", \"शिव\", \"सिद्ध\", \"साध्य\", \"शुभ\", \"शुक्ल\", \"ब्रह्म\", \"ऐन्द्र\", \"वैधृति\"\n  ];\n  const KARANA_NAMES = [\"बव\", \"बालव\", \"कौलव\", \"तैतिल\", \"गर\", \"वणिज\", \"विष्टि (भद्रा)\", \"शकुनि\", \"चतुष्पाद\", \"नाग\", \"किंस्तुघ्न\"];\n  const SAMVATSARA_NAMES = [\n    \"प्रभव\", \"विभव\", \"शुक्ल\", \"प्रमोद\", \"प्रजापति\", \"अङ्गिरा\", \"श्रीमुख\", \"भाव\", \"युवा\", \"धाता\",\n    \"ईश्वर\", \"बहुधान्य\", \"प्रमाथी\", \"विक्रम\", \"वृषप्रजा\", \"चित्रभानु\", \"सुभानु\", \"तारण\", \"पार्थिव\", \"व्यय\",\n    \"सर्वजित्\", \"सर्वधारी\", \"विरोधी\", \"विकृत\", \"खर\", \"नन्दन\", \"विजय\", \"जय\", \"मन्मथ\", \"दुर्मुख\",\n    \"हेमलम्ब\", \"विलम्ब\", \"विकारी\", \"शार्वरी\", \"प्लव\", \"शुभकृत\", \"शोभकृत\", \"क्रोधन\", \"क्षय\", \"पराभव\",\n    \"प्लवङ्ग\", \"कीलक\", \"सौम्य\", \"साधारण\", \"विरोधकृत\", \"परिधावी\", \"प्रमादी\", \"आनन्द\", \"राक्षस\", \"नल\",\n    \"पिङ्गल\", \"कालयुक्त\", \"सिद्धार्थी\", \"रौद्र\", \"दुर्मति\", \"दुन्दुभि\", \"रुधिरोद्गारी\", \"रक्ताक्ष\", \"क्रोधन\", \"क्षय\"\n  ];\n\n  const DICT = {\n    \"hi\": {\n      code: \"hi\",\n      toggleBtn: \"🌐 EN-IN\",\n      NAMES: { Amrit: \"अमृत\", Shubh: \"शुभ\", Labh: \"लाभ\", Char: \"चर\", Rog: \"रोग\", Kaal: \"काल\", Udveg: \"उद्वेग\" },\n      SHORT_NAMES: { Amrit: \"अमृत\", Shubh: \"शुभ\", Labh: \"लाभ\", Char: \"चर\", Rog: \"रोग\", Kaal: \"काल\", Udveg: \"उद्वेग\" },\n      MEANING: { Amrit: \"सर्वोत्तम\", Shubh: \"शुभ\", Labh: \"लाभ\", Char: \"सामान्य\", Rog: \"अशुभ (रोग)\", Kaal: \"अशुभ (हानि)\", Udveg: \"अशुभ (चिंता)\" },\n      STATUS: {\n        Amrit: \"सर्वोत्तम शुभ\", Shubh: \"शुभ समय\", Labh: \"लाभकारी\", Char: \"सामान्य (चर)\",\n        Rog: \"अशुभ (टालें)\", Kaal: \"अशुभ (टालें)\", Udveg: \"अशुभ (टालें)\"\n      },\n      MARK_LABEL: { rahu: \"राहु काल\", kaalVela: \"काल वेला\", vaarVela: \"वार वेला\", kaalRatri: \"काल रात्रि\" },\n      MARK_SHORT: { rahu: \"राहु\", kaalVela: \"काल.वे\", vaarVela: \"वार.वे\", kaalRatri: \"काल.रा\" },\n      TITHI: [\n        \"प्रतिपदा\", \"द्वितीया\", \"तृतीया\", \"चतुर्थी\", \"पंचमी\", \"षष्ठी\", \"सप्तमी\",\n        \"अष्टमी\", \"नवमी\", \"दशमी\", \"एकादशी\", \"द्वादशी\", \"त्रयोदशी\", \"चतुर्दशी\"\n      ],\n      HINDU_MONTHS: [\n        \"चैत्र\", \"वैशाख\", \"ज्येष्ठ\", \"आषाढ़\", \"श्रावण\", \"भाद्रपद\",\n        \"अश्विन\", \"कार्तिक\", \"मार्गशीर्ष\", \"पौष\", \"माघ\", \"फाल्गुन\"\n      ],\n      WEEKDAYS: [\"रविवार\", \"सोमवार\", \"मंगलवार\", \"बुधवार\", \"गुरुवार\", \"शुक्रवार\", \"शनिवार\"],\n      WEEKDAY_SHORT: [\"रवि\", \"सोम\", \"मंगल\", \"बुध\", \"गुरु\", \"शुक्र\", \"शनि\"],\n      MONTHS: [\"जनवरी\", \"फ़रवरी\", \"मार्च\", \"अप्रैल\", \"मई\", \"जून\", \"जुलाई\", \"अगस्त\", \"सितंबर\", \"अक्टूबर\", \"नवंबर\", \"दिसंबर\"],\n      purnima: \"पूर्णिमा\",\n      amavasya: \"अमावस्या\",\n      purnimaShort: \"पूर्णिमा\",\n      amavasyaShort: \"अमावस्या\",\n      shukla: \"शुक्ल पक्ष\",\n      krishna: \"कृष्ण पक्ष\",\n      shuklaShort: \"शुक्ल \",\n      krishnaShort: \"कृष्ण \",\n      subah: \"सुबह\",\n      dopahar: \"दोपहर\",\n      shaam: \"शाम\",\n      raat: \"रात\",\n      kalPrefix: \"कल \",\n      endsLabel: \"समाप्ति\",\n      phirLabel: \"फिर\",\n      rahuTitle: \"राहु काल\",\n      rahuAvoid: \"इस अवधि में शुभ कार्य टालें\",\n      rahuAvoidLong: \"इस अवधि में शुभ कार्य टालें (अशुभ समय)\",\n      shubhTitle: \"सर्वोत्तम शुभ समय\",\n      shubhWindowsTitle: \"सर्वोत्तम शुभ मुहूर्त\",\n      startWork: \"शुभ कार्य करें\",\n      noWindow24: \"अगले 24 घंटों में कोई शुभ मुहूर्त नहीं\",\n      noWindowDay: \"इस दिन कोई शुभ चौघड़िया मुहूर्त नहीं है।\",\n      dayChoghadiya: \"☀️ दिन का चौघड़िया\",\n      nightChoghadiya: \"🌙 रात का चौघड़िया\",\n      sunriseLabel: \"सूर्योदय\",\n      sunsetLabel: \"सूर्यास्त\",\n      chip: { now: \"अभी चालू\", today: \"आज\", tomorrow: \"कल\" },\n      chipShort: { now: \"अभी\", today: \"आज\", tomorrow: \"कल\" },\n      nowWord: \"अभी\",\n      liveBannerTitle: \"अभी का चौघड़िया\",\n      prevNightNote: \" · पिछली रात का चौघड़िया\",\n      timeLeft: \"शेष समय\",\n      goToday: \"आज पर जाएँ\",\n      selectDate: \"📅 तारीख चुनें\",\n      relToday: \"आज\",\n      relTomorrow: \"कल (आने वाला)\",\n      relYesterday: \"कल (बीता हुआ)\",\n      relLater: function(n) { return n + \" दिन बाद\"; },\n      relAgo: function(n) { return n + \" दिन पहले\"; },\n      apiBadgeLive: \"⚡ लाइव सर्वर (rc.arthsathi.com)\",\n      apiBadgeLocal: \"📡 ऑफ़लाइन गणना\",\n      festivalsTitle: \"त्योहार एवं व्रत\",\n      noFestival: \"आज कोई प्रमुख त्योहार नहीं है\",\n      sankalpTitle: \"🕉️ ॥ सम्पूर्णः वैदिक-संकल्प-पाठः ॥\",\n      inauspiciousDueToRahu: \"अशुभ (राहु काल/वेला प्रभाव)\",\n      note1: \"<b>★ अमृत</b>, <b>✓ शुभ</b> और <b>✓ लाभ</b> महत्वपूर्ण कार्यों के लिए सर्वोत्तम चौघड़िया हैं। <b>– चर</b> सामान्य (यात्रा हेतु उपयुक्त) है।\",\n      note2: \"<b>✕ राहु काल, काल वेला, वार वेला</b> अथवा <b>काल रात्रि</b> पड़ने पर उस समय का अमृत/शुभ प्रभाव निष्फल (अशुभ) हो जाता है — इन्हें ऊपर शुभ मुहूर्तों से स्वतः बाहर रखा गया है।\",\n      noteLoc: function(p, lat, lon, src) { return \"📍 समय गणना <b>\" + p + \"</b> (\" + lat + \"°N, \" + lon + \"°E) · Asia/Kolkata (IST) · \" + src + \"।\"; },\n      devBy: \"Arthsathi Limited द्वारा विकसित ·\"\n    },\n    \"en-IN\": {\n      code: \"en-IN\",\n      toggleBtn: \"🌐 हिंदी\",\n      NAMES: { Amrit: \"Amrit\", Shubh: \"Shubh\", Labh: \"Labh\", Char: \"Char\", Rog: \"Rog\", Kaal: \"Kaal\", Udveg: \"Udveg\" },\n      SHORT_NAMES: { Amrit: \"Amrita\", Shubh: \"Shubha\", Labh: \"Labha\", Char: \"Chara\", Rog: \"Roga\", Kaal: \"Kala\", Udveg: \"Udvega\" },\n      MEANING: { Amrit: \"Best\", Shubh: \"Good\", Labh: \"Gain\", Char: \"Neutral\", Rog: \"Evil\", Kaal: \"Loss\", Udveg: \"Bad\" },\n      STATUS: {\n        Amrit: \"Most Auspicious\", Shubh: \"Auspicious\", Labh: \"Beneficial\", Char: \"Neutral\",\n        Rog: \"Inauspicious\", Kaal: \"Inauspicious\", Udveg: \"Inauspicious\"\n      },\n      MARK_LABEL: { rahu: \"Rahu Kaal\", kaalVela: \"Kaal Vela\", vaarVela: \"Vaar Vela\", kaalRatri: \"Kaal Ratri\" },\n      MARK_SHORT: { rahu: \"Rahu\", kaalVela: \"K.Vela\", vaarVela: \"V.Vela\", kaalRatri: \"K.Ratri\" },\n      TITHI: [\n        \"Pratipada\", \"Dwitiya\", \"Tritiya\", \"Chaturthi\", \"Panchami\", \"Shashthi\", \"Saptami\",\n        \"Ashtami\", \"Navami\", \"Dashami\", \"Ekadashi\", \"Dwadashi\", \"Trayodashi\", \"Chaturdashi\"\n      ],\n      HINDU_MONTHS: [\n        \"Chaitra\", \"Vaishakha\", \"Jyeshtha\", \"Ashadha\", \"Shravana\", \"Bhadrapada\",\n        \"Ashwin\", \"Kartika\", \"Margashirsha\", \"Pausha\", \"Magha\", \"Phalguna\"\n      ],\n      WEEKDAYS: [\"Sunday\", \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"],\n      WEEKDAY_SHORT: [\"Sun\", \"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\"],\n      MONTHS: [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"],\n      purnima: \"Purnima\",\n      amavasya: \"Amavasya\",\n      purnimaShort: \"Purnima\",\n      amavasyaShort: \"Amavasya\",\n      shukla: \"Shukla Paksha\",\n      krishna: \"Krishna Paksha\",\n      shuklaShort: \"Shukla \",\n      krishnaShort: \"Krishna \",\n      subah: \"Subah\",\n      dopahar: \"Dopahar\",\n      shaam: \"Shaam\",\n      raat: \"Raat\",\n      kalPrefix: \"Kal \",\n      endsLabel: \"Ends\",\n      phirLabel: \"Phir\",\n      rahuTitle: \"Rahu Kaal\",\n      rahuAvoid: \"Avoid auspicious work\",\n      rahuAvoidLong: \"Avoid auspicious work (Is awadhi me shubh kaarya taalein)\",\n      shubhTitle: \"Most Auspicious\",\n      shubhWindowsTitle: \"Most Auspicious Windows\",\n      startWork: \"Start work\",\n      noWindow24: \"No auspicious window in the next 24 hours\",\n      noWindowDay: \"No auspicious window on this day.\",\n      dayChoghadiya: \"☀️ Day Choghadiya\",\n      nightChoghadiya: \"🌙 Night Choghadiya\",\n      sunriseLabel: \"Sunrise\",\n      sunsetLabel: \"Sunset\",\n      chip: { now: \"Live Now\", today: \"Today\", tomorrow: \"Tomorrow\" },\n      chipShort: { now: \"NOW\", today: \"TODAY\", tomorrow: \"TMRW\" },\n      nowWord: \"Now\",\n      liveBannerTitle: \"Abhi (Live Now)\",\n      prevNightNote: \" · Prev. Night Choghadiya\",\n      timeLeft: \"Time left\",\n      goToday: \"Go to Today\",\n      selectDate: \"📅 Select Date\",\n      relToday: \"Aaj (Today)\",\n      relTomorrow: \"Kal (Tomorrow)\",\n      relYesterday: \"Kal (Yesterday)\",\n      relLater: function(n) { return n + \" days later\"; },\n      relAgo: function(n) { return n + \" days ago\"; },\n      apiBadgeLive: \"⚡ Live Server (rc.arthsathi.com)\",\n      apiBadgeLocal: \"📡 Offline Calculation\",\n      festivalsTitle: \"Festivals & Vrat\",\n      noFestival: \"No major festival today\",\n      sankalpTitle: \"🕉️ ॥ सम्पूर्णः वैदिक-संकल्प-पाठः ॥\",\n      inauspiciousDueToRahu: \"Inauspicious (Rahu/Vela clash)\",\n      note1: \"<b>★ Amrita</b>, <b>✓ Shubha</b> and <b>✓ Labha</b> are the most auspicious Choghadiya for important tasks. <b>– Chara</b> is neutral (good for travel).\",\n      note2: \"<b>✕ Rahu Kaal, Kaal Vela, Vaar Vela</b> or <b>Kaal Ratri</b> cancel out auspiciousness — they are automatically excluded from the Most Auspicious Windows above.\",\n      noteLoc: function(p, lat, lon, src) { return \"📍 Timings for <b>\" + p + \"</b> (\" + lat + \"°N, \" + lon + \"°E) · Asia/Kolkata (IST) · \" + src + \".\"; },\n      devBy: \"Developed by Arthsathi Limited ·\"\n    }\n  };\n\n  const L = DICT[LANG];\n  const TONE = { Amrit: \"best\", Shubh: \"good\", Labh: \"good\", Char: \"neutral\", Rog: \"bad\", Kaal: \"bad\", Udveg: \"bad\" };\n  const SIGN = { best: \"★\", good: \"✓\", neutral: \"–\", bad: \"✕\" };\n\n  const DAY_SEQ = [\n    [\"Udveg\", \"Char\", \"Labh\", \"Amrit\", \"Kaal\", \"Shubh\", \"Rog\", \"Udveg\"],\n    [\"Amrit\", \"Kaal\", \"Shubh\", \"Rog\", \"Udveg\", \"Char\", \"Labh\", \"Amrit\"],\n    [\"Rog\", \"Udveg\", \"Char\", \"Labh\", \"Amrit\", \"Kaal\", \"Shubh\", \"Rog\"],\n    [\"Labh\", \"Amrit\", \"Kaal\", \"Shubh\", \"Rog\", \"Udveg\", \"Char\", \"Labh\"],\n    [\"Shubh\", \"Rog\", \"Udveg\", \"Char\", \"Labh\", \"Amrit\", \"Kaal\", \"Shubh\"],\n    [\"Char\", \"Labh\", \"Amrit\", \"Kaal\", \"Shubh\", \"Rog\", \"Udveg\", \"Char\"],\n    [\"Kaal\", \"Shubh\", \"Rog\", \"Udveg\", \"Char\", \"Labh\", \"Amrit\", \"Kaal\"]\n  ];\n  const NIGHT_SEQ = [\n    [\"Shubh\", \"Amrit\", \"Char\", \"Rog\", \"Kaal\", \"Labh\", \"Udveg\", \"Shubh\"],\n    [\"Char\", \"Rog\", \"Kaal\", \"Labh\", \"Udveg\", \"Shubh\", \"Amrit\", \"Char\"],\n    [\"Kaal\", \"Labh\", \"Udveg\", \"Shubh\", \"Amrit\", \"Char\", \"Rog\", \"Kaal\"],\n    [\"Udveg\", \"Shubh\", \"Amrit\", \"Char\", \"Rog\", \"Kaal\", \"Labh\", \"Udveg\"],\n    [\"Amrit\", \"Char\", \"Rog\", \"Kaal\", \"Labh\", \"Udveg\", \"Shubh\", \"Amrit\"],\n    [\"Rog\", \"Kaal\", \"Labh\", \"Udveg\", \"Shubh\", \"Amrit\", \"Char\", \"Rog\"],\n    [\"Labh\", \"Udveg\", \"Shubh\", \"Amrit\", \"Char\", \"Rog\", \"Kaal\", \"Labh\"]\n  ];\n  const RAHU_SEGMENT = [7, 1, 6, 4, 5, 3, 2];\n  const VAAR_VELA = [3, 6, 1, 4, 7, 2, 5];\n\n  function sunTimes(date, lat, lon) {\n    const p = istParts(date);\n    const noon = fromIST(p.year, p.month, p.date, 12, 0);\n    const d = noon.valueOf() / DAY_MS - 0.5 + J1970 - J2000;\n    const lw = -lon * RAD, phi = lat * RAD, TWO_PI = 2 * Math.PI;\n    const n = Math.round(d - 0.0009 - lw / TWO_PI);\n    const ds = 0.0009 + lw / TWO_PI + n;\n    const M = RAD * (357.5291 + 0.98560028 * ds);\n    const eqC = RAD * (1.9148 * Math.sin(M) + 0.02 * Math.sin(2 * M) + 0.0003 * Math.sin(3 * M));\n    const L = M + eqC + RAD * 102.9372 + Math.PI;\n    const dec = Math.asin(Math.sin(RAD * 23.4397) * Math.sin(L));\n    const transit = a => J2000 + a + 0.0053 * Math.sin(M) - 0.0069 * Math.sin(2 * L);\n    const jNoon = transit(ds);\n    const h0 = -0.833 * RAD;\n    const cosW = (Math.sin(h0) - Math.sin(phi) * Math.sin(dec)) / (Math.cos(phi) * Math.cos(dec));\n    const w = Math.acos(Math.max(-1, Math.min(1, cosW)));\n    const jSet = transit(0.0009 + (w + lw) / TWO_PI + n);\n    const jRise = jNoon - (jSet - jNoon);\n    const toDate = j => new Date((j + 0.5 - J1970) * DAY_MS);\n    return { rise: toDate(jRise), set: toDate(jSet) };\n  }\n\n  const MOON_TERMS = [\n    [0,0,1,0,6288774],[2,0,-1,0,1274027],[2,0,0,0,658314],[0,0,2,0,213618],[0,1,0,0,-185116],\n    [0,0,0,2,-114332],[2,0,-2,0,58793],[2,-1,-1,0,57066],[2,0,1,0,53322],[2,-1,0,0,45758],\n    [0,1,-1,0,-40923],[1,0,0,0,-34720],[0,1,1,0,-30383],[2,0,0,-2,15327],[0,0,1,2,-12528],\n    [0,0,1,-2,10980],[4,0,-1,0,10675],[0,0,3,0,10034],[4,0,-2,0,8548],[2,1,-1,0,-7888],\n    [2,1,0,0,-6766],[1,0,-1,0,-5163],[1,1,0,0,4987],[2,-1,1,0,4036],[2,0,2,0,3994],\n    [4,0,0,0,3861],[2,0,-3,0,3665],[0,1,-2,0,-2689],[2,0,-1,2,-2602],[2,-1,-2,0,2390],\n    [1,0,1,0,-2348],[2,-2,0,0,2236],[0,1,2,0,-2120],[0,2,0,0,-2069],[2,-2,-1,0,2048],\n    [2,0,1,-2,-1773],[2,0,0,2,-1595],[4,-1,-1,0,1215],[0,0,2,2,-1110],[3,0,-1,0,-892],\n    [2,1,1,0,-810],[4,-1,-2,0,759],[0,2,-1,0,-713],[2,2,-1,0,-700],[2,1,-2,0,691],\n    [2,-1,0,-2,596],[4,0,1,0,549],[0,0,4,0,537],[4,-1,0,0,520],[1,0,-2,0,-487]\n  ];\n\n  function moonLon(jd) {\n    const T = (jd - J2000) / 36525;\n    const Lp = 218.3164477 + 481267.88123421 * T - 0.0015786 * T * T;\n    const D = 297.8501921 + 445267.1114034 * T - 0.0018819 * T * T;\n    const M = 357.5291092 + 35999.0502909 * T - 0.0001536 * T * T;\n    const Mp = 134.9633964 + 477198.8675055 * T + 0.0087414 * T * T;\n    const F = 93.2720950 + 483202.0175233 * T - 0.0036539 * T * T;\n    const E = 1 - 0.002516 * T - 0.0000074 * T * T;\n    let s = 0;\n    for (const [d, m, mp, f, c] of MOON_TERMS) {\n      const e = Math.abs(m) === 1 ? E : Math.abs(m) === 2 ? E * E : 1;\n      s += c * e * Math.sin(RAD * (d * D + m * M + mp * Mp + f * F));\n    }\n    s += 3958 * Math.sin(RAD * (119.75 + 131.849 * T))\n       + 1962 * Math.sin(RAD * (Lp - F))\n       + 318 * Math.sin(RAD * (53.09 + 479264.29 * T));\n    return mod360(Lp + s / 1e6);\n  }\n\n  function sunLon(jd) {\n    const T = (jd - J2000) / 36525;\n    const L0 = 280.46646 + 36000.76983 * T + 0.0003032 * T * T;\n    const M = RAD * (357.52911 + 35999.05029 * T - 0.0001537 * T * T);\n    const C = (1.914602 - 0.004817 * T - 0.000014 * T * T) * Math.sin(M)\n            + (0.019993 - 0.000101 * T) * Math.sin(2 * M) + 0.000289 * Math.sin(3 * M);\n    return mod360(L0 + C - 0.00569);\n  }\n\n  function elongation(date) {\n    const jd = date.getTime() / DAY_MS + 2440587.5;\n    return mod360(moonLon(jd) - sunLon(jd));\n  }\n\n  function sunLonSidereal(date) {\n    const jd = date.getTime() / DAY_MS + 2440587.5;\n    const T = (jd - J2000) / 36525;\n    const ayanamsha = 23.85 + 1.396 * T;\n    return mod360(sunLon(jd) - ayanamsha);\n  }\n\n  function moonLonSidereal(date) {\n    const jd = date.getTime() / DAY_MS + 2440587.5;\n    const T = (jd - J2000) / 36525;\n    const ayanamsha = 23.85 + 1.396 * T;\n    return mod360(moonLon(jd) - ayanamsha);\n  }\n\n  function tithiAt(date) {\n    const e = elongation(date);\n    const n = Math.min(30, Math.floor(e / 12) + 1);\n    const target = (n * 12) % 360;\n    const rem = ((n * 12) - e + 360) % 360 || 12;\n    let t = date.getTime() + (rem / 12.19) * DAY_MS;\n    for (let i = 0; i < 8; i++) {\n      const e0 = elongation(new Date(t));\n      const diff = ((target - e0) % 360 + 540) % 360 - 180;\n      if (Math.abs(diff) < 1e-4) break;\n      const e1 = elongation(new Date(t + 3600000));\n      const dDeg = ((e1 - e0) % 360 + 540) % 360 - 180;\n      const rate = (dDeg > 0.05 ? dDeg : 0.508) / 3600000;\n      t += diff / rate;\n    }\n    return { n: n, end: new Date(t), name: null };\n  }\n\n  function getHindiMitti(date, tithiN) {\n    const p = istParts(date);\n    const sLon = sunLonSidereal(date);\n    const rashiIdx = Math.floor(sLon / 30);\n    const mIdx = (rashiIdx + 1) % 12; // Fixed Hindu lunar month correspondence\n    const isNewYear = mIdx === 0 && tithiN <= 15;\n    // Corrected Samvat rollover for pre-Chaitra dates (Jan, Feb, early March)\n    const isPreChaitra = (p.month < 2) || (p.month === 2 && !isNewYear);\n    const vikram = p.year + 57 - (isPreChaitra ? 1 : 0);\n    const shaka = p.year - 78 - (isPreChaitra ? 1 : 0);\n    const monthName = L.HINDU_MONTHS[mIdx];\n    const pakshaName = tithiN <= 15 ? L.shukla : L.krishna;\n    const tithiName = tithiN === 15 ? L.purnima : tithiN === 30 ? L.amavasya : L.TITHI[(tithiN - 1) % 15];\n    const fullMitti = monthName + \" \" + pakshaName + \" \" + tithiName;\n    const samvatStr = (LANG === \"hi\" ? \"विक्रम संवत \" : \"Vikram Samvat \") + vikram + (LANG === \"hi\" ? \" · शक संवत \" : \" · Shaka \") + shaka;\n    return {\n      monthIdx: mIdx,\n      monthName: monthName,\n      paksha: pakshaName,\n      tithiName: tithiName,\n      fullMitti: fullMitti,\n      vikram: vikram,\n      shaka: shaka,\n      samvatStr: samvatStr\n    };\n  }\n\n  function getFestivals(date, tithiN, mitti) {\n    const list = [];\n    const m = mitti.monthIdx;\n    const t = tithiN;\n\n    if (t === 11 || t === 26) list.push(LANG === \"hi\" ? \"एकादशी व्रत\" : \"Ekadashi Vrat\");\n    if (t === 13 || t === 28) list.push(LANG === \"hi\" ? \"प्रदोष व्रत\" : \"Pradosh Vrat\");\n    if (t === 4) list.push(LANG === \"hi\" ? \"विनायक चतुर्थी\" : \"Vinayaka Chaturthi\");\n    if (t === 19) list.push(LANG === \"hi\" ? \"संकष्टी चतुर्थी\" : \"Sankashti Chaturthi\");\n\n    if (m === 0 && t === 1) list.push(LANG === \"hi\" ? \"चैत्र नवरात्र प्रारंभ (नव संवत्सर)\" : \"Chaitra Navratri / Hindu New Year\");\n    if (m === 0 && t === 9) list.push(LANG === \"hi\" ? \"राम नवमी\" : \"Rama Navami\");\n    if (m === 0 && t === 15) list.push(LANG === \"hi\" ? \"हनुमान जयंती\" : \"Hanuman Jayanti\");\n    if (m === 1 && t === 3) list.push(LANG === \"hi\" ? \"अक्षय तृतीया\" : \"Akshaya Tritiya\");\n    if (m === 4 && t === 15) list.push(LANG === \"hi\" ? \"रक्षाबंधन\" : \"Raksha Bandhan\");\n    if (m === 5 && t === 23) list.push(LANG === \"hi\" ? \"श्री कृष्ण जन्माष्टमी\" : \"Krishna Janmashtami\");\n    if (m === 5 && t === 4) list.push(LANG === \"hi\" ? \"गणेश चतुर्थी\" : \"Ganesh Chaturthi\");\n    if (m === 6 && t === 1) list.push(LANG === \"hi\" ? \"शारदीय नवरात्र प्रारंभ\" : \"Sharad Navratri Begins\");\n    if (m === 6 && t === 10) list.push(LANG === \"hi\" ? \"दशहरा / विजयदशमी\" : \"Dussehra / Vijayadashami\");\n    if (m === 6 && t === 15) list.push(LANG === \"hi\" ? \"शरद पूर्णिमा\" : \"Sharad Purnima\");\n    if (m === 7 && t === 19) list.push(LANG === \"hi\" ? \"करवा चौथ\" : \"Karwa Chauth\");\n    if (m === 7 && t === 28) list.push(LANG === \"hi\" ? \"धनतेरस\" : \"Dhanteras\");\n    if (m === 7 && t === 30) list.push(LANG === \"hi\" ? \"दीपावली (लक्ष्मी पूजन)\" : \"Diwali (Lakshmi Puja)\");\n    if (m === 7 && t === 1) list.push(LANG === \"hi\" ? \"गोवर्धन पूजा\" : \"Govardhan Puja\");\n    if (m === 7 && t === 2) list.push(LANG === \"hi\" ? \"भाई दूज\" : \"Bhai Dooj\");\n    if (m === 7 && t === 6) list.push(LANG === \"hi\" ? \"छठ पूजा\" : \"Chhath Puja\");\n    if (m === 7 && t === 15) list.push(LANG === \"hi\" ? \"देव दीपावली / कार्तिक पूर्णिमा\" : \"Dev Deepawali\");\n    if (m === 10 && t === 5) list.push(LANG === \"hi\" ? \"बसंत पंचमी / सरस्वती पूजा\" : \"Vasant Panchami\");\n    if (m === 10 && t === 29) list.push(LANG === \"hi\" ? \"महाशिवरात्रि\" : \"Maha Shivaratri\");\n    if (m === 11 && t === 14) list.push(LANG === \"hi\" ? \"होलिका दहन\" : \"Holika Dahan\");\n    if (m === 11 && t === 15) list.push(LANG === \"hi\" ? \"होली\" : \"Holi\");\n\n    return list;\n  }\n\n  function generateVedicSankalp(date, tithiN, mitti) {\n    const p = istParts(date);\n    const sLonSid = sunLonSidereal(date);\n    const mLonSid = moonLonSidereal(date);\n    const sunRashiIdx = Math.floor(sLonSid / 30);\n    const moonRashiIdx = Math.floor(mLonSid / 30);\n\n    const nakshatraIdx = Math.floor(mLonSid / (360 / 27));\n    const yogaIdx = Math.floor(mod360(sLonSid + mLonSid) / (360 / 27));\n    const karanaIdx = (tithiN <= 1) ? 10 : (tithiN >= 30) ? 9 : (tithiN === 29) ? 8 : (tithiN === 28 && p.hours >= 12) ? 7 : (Math.floor(elongation(date) / 6) - 1) % 7;\n\n    const samvatsaraIdx = (mitti.vikram + 9) % 60;\n    const samvatsaraName = SAMVATSARA_NAMES[samvatsaraIdx];\n\n    const isUttarayana = (sLonSid >= 270 || sLonSid < 90);\n    const ayana = isUttarayana ? \"उत्तरायणे\" : \"दक्षिणायने\";\n\n    const rituNames = [\"वसन्त\", \"ग्रीष्म\", \"वर्षा\", \"शरद्\", \"हेमन्त\", \"शिशिर\"];\n    const ritu = rituNames[Math.floor(sLonSid / 60)];\n\n    const monthSanskrit = SANSKRIT_MONTHS[mitti.monthIdx];\n    const pakshaSanskrit = (tithiN <= 15 ? \"शुक्ल\" : \"कृष्ण\") + \" पक्षे\";\n    const tithiSanskrit = (tithiN === 15 ? \"पूर्णिमायां\" : tithiN === 30 ? \"अमावास्यायां\" : SANSKRIT_TITHI[(tithiN - 1) % 15]) + \" तिथौ\";\n    const vaarSanskrit = SANSKRIT_VAAR[p.day] + \" वासरे\";\n    const nakshatraSanskrit = NAKSHATRA_NAMES[nakshatraIdx] + \" नक्षत्रे\";\n    const yogaSanskrit = YOGA_NAMES[yogaIdx] + \" योगे\";\n    const karanaSanskrit = KARANA_NAMES[karanaIdx] + \" करणे\";\n    const sunRashiSanskrit = SANSKRIT_RASHI[sunRashiIdx] + \" राशिस्थिते सूर्ये\";\n    const moonRashiSanskrit = SANSKRIT_RASHI[moonRashiIdx] + \" राशिस्थिते चन्द्रे\";\n\n    return (\n      \"<i>ॐ विष्णुर्विष्णुर्विष्णुः श्रीमद्भगवतो महापुरुषस्य विष्णोराज्ञया प्रवर्तमानस्य अद्य श्रीब्रह्मणो द्वितीयपरार्धे श्रीश्वेतवाराहकल्पे वैवस्वतमन्वन्तरे अष्टाविंशतितमे कलियुगे कलिप्रथमचरणे भूर्लोके जम्बूद्वीपे भारतवर्षे भरतखण्डे आर्यावर्तैकदेशान्तर्गत-</i>\" +\n      \"<b>इन्द्रप्रस्थ (देहली)</b> <i>नगरे</i> <b>यमुना</b><i>-तीरे</i> <b>श्रेष्ठ-विहार-क्षेत्रे मकान-संख्या-११८ भवने</b> <i>बौद्धावतारे वर्तमाने</i> \" +\n      \"<b>\" + samvatsaraName + \"</b> <i>नाम संवत्सरे</i> <b>\" + ayana + \"</b> <b>\" + ritu + \"</b> <i>ऋतौ महामाङ्गल्यप्रदे</i> \" +\n      \"<b>\" + monthSanskrit + \"</b> <i>मासे</i> <b>\" + pakshaSanskrit + \"</b> <b>\" + tithiSanskrit + \"</b> <b>\" + vaarSanskrit + \"</b> \" +\n      \"<b>\" + nakshatraSanskrit + \"</b> <b>\" + yogaSanskrit + \"</b> <b>\" + karanaSanskrit + \"</b> \" +\n      \"<b>\" + sunRashiSanskrit + \"</b> <b>\" + moonRashiSanskrit + \"</b> <i>सत्सु शुभेषु शुभयोगेषु</i> \" +\n      \"<b>गर्ग</b> <i>गोत्रोत्पन्नः</i> <b>मनीष गुप्ता</b> <i>नामाहं, मम धर्मपत्न्याः</i> <b>अंजलि गुप्ता</b> <i>नाम्न्याः, मम पुत्रस्य</i> <b>आर्य गुप्ता</b> <i>नाम्नः, मम पुत्र्याः</i> <b>अलीशा गुप्ता</b> <i>नाम्न्याः, मम पूज्य-पितुः</i> <b>अशोक गुप्ता</b> <i>नाम्नः, पूज्यायाः मातुः</i> <b>हेमलता गुप्ता</b> <i>नाम्न्याः, मम भ्रातुः</i> <b>आशीष गुप्ता</b> <i>नाम्नः, मम भगिन्याः</i> <b>दीपिका गुप्ता</b> <i>नाम्न्याः, तथा च सपरिवारस्य सकुटुम्बस्य कायिक-वाचिक-मानसिक-सकलपापनिवृत्तिपूर्वकं धर्मार्थकाममोक्ष-चतुर्विधपुरुषार्थसिद्धये, सकल-मनोरथ-सिद्धये, धन-धान्य-आरोग्य-ऐश्वर्य-प्राप्त्यर्थं</i> \" +\n      \"<b>__________________</b> <i>निमित्ते अस्माकं कुल/इष्ट-देव्याः</i> <b>श्री दुर्गा / शेराँवाली माता</b> <i>पूजनमहं करिष्ये।</i>\"\n    );\n  }\n\n  function tithiLabel(n, customName) {\n    if (customName) return String(customName);\n    if (n === 15) return L.purnima;\n    if (n === 30) return L.amavasya;\n    return (n < 15 ? L.shukla : L.krishna) + \" · \" + L.TITHI[(n - 1) % 15];\n  }\n  function tithiShort(n, customName) {\n    if (customName) return String(customName);\n    if (n === 15) return L.purnimaShort;\n    if (n === 30) return L.amavasyaShort;\n    return (n < 15 ? L.shuklaShort : L.krishnaShort) + L.TITHI[(n - 1) % 15];\n  }\n  function moonEmoji(n) {\n    if (n <= 5) return \"🌒\";\n    if (n <= 9) return \"🌓\";\n    if (n <= 14) return \"🌔\";\n    if (n === 15) return \"🌕\";\n    if (n <= 20) return \"🌖\";\n    if (n <= 24) return \"🌗\";\n    if (n <= 29) return \"🌘\";\n    return \"🌑\";\n  }\n\n  function startOfDay(d) {\n    const p = istParts(d);\n    return fromIST(p.year, p.month, p.date, 0, 0);\n  }\n  function addDays(date, k) {\n    return new Date(date.getTime() + k * DAY_MS);\n  }\n  function dayOffset(d, ref) {\n    let dd = Math.round((startOfDay(d) - startOfDay(ref)) / DAY_MS);\n    if (istParts(d).hours < 4 && dd > 0) dd -= 1;\n    return dd;\n  }\n\n  function halfDay(start, end, names, night, wd) {\n    const len = (end - start) / 8;\n    return names.map((name, i) => {\n      const p = {\n        name: name, night: night, i: i, marks: [],\n        start: new Date(start.getTime() + i * len),\n        end: new Date(start.getTime() + (i + 1) * len)\n      };\n      if (!night) {\n        if (i === RAHU_SEGMENT[wd]) p.marks.push(\"rahu\");\n        if (name === \"Kaal\") p.marks.push(\"kaalVela\");\n        if (i === VAAR_VELA[wd]) p.marks.push(\"vaarVela\");\n      } else if (name === \"Labh\") {\n        p.marks.push(\"kaalRatri\");\n      }\n      return p;\n    });\n  }\n\n  function rahuKaal(sun, wd) {\n    const len = (sun.set - sun.rise) / 8, i = RAHU_SEGMENT[wd];\n    return {\n      start: new Date(sun.rise.getTime() + i * len),\n      end: new Date(sun.rise.getTime() + (i + 1) * len),\n      label: null\n    };\n  }\n\n  function dayChunk(date, lat, lon) {\n    const day = startOfDay(date), wd = istParts(day).day;\n    const sun = sunTimes(day, lat, lon), sunN = sunTimes(addDays(day, 1), lat, lon);\n    return {\n      day: day, wd: wd, sun: sun, sunN: sunN, rahu: rahuKaal(sun, wd),\n      dayPeriods: halfDay(sun.rise, sun.set, DAY_SEQ[wd], false, wd),\n      nightPeriods: halfDay(sun.set, sunN.rise, NIGHT_SEQ[wd], true, wd)\n    };\n  }\n\n  function goodWindows(periods) {\n    const out = [];\n    for (const p of periods) {\n      if (TONE[p.name] === \"bad\" || TONE[p.name] === \"neutral\" || p.marks.length) continue;\n      const last = out[out.length - 1];\n      if (last && Math.abs(p.start - last.end) < 60000) {\n        last.end = p.end;\n        if (last.names.indexOf(p.name) === -1) last.names.push(p.name);\n      } else {\n        out.push({ start: p.start, end: p.end, names: [p.name] });\n      }\n    }\n    return out;\n  }\n\n  function statusOf(win, now) {\n    if (now >= win.start && now < win.end) return \"now\";\n    return dayOffset(win.start, now) <= 0 ? \"today\" : \"tomorrow\";\n  }\n\n  function applyApiToWidgetData(base, api, now) {\n    if (!api || typeof api !== \"object\") {\n      base.fromApi = false;\n      return base;\n    }\n    base.fromApi = true;\n\n    if (api.tithi && typeof api.tithi === \"object\") {\n      if (api.tithi.name) base.tithi.name = String(api.tithi.name).trim();\n      if (api.tithi.number || api.tithi.n) {\n        const num = parseInt(api.tithi.number || api.tithi.n, 10);\n        if (num >= 1 && num <= 30) base.tithi.n = num;\n      }\n      const tEnd = parseApiTime(api.tithi.end || api.tithi.endTime, now);\n      if (tEnd) base.tithi.end = tEnd;\n    }\n\n    if (api.rahu && typeof api.rahu === \"object\") {\n      if (api.rahu.label) base.rahu.label = String(api.rahu.label).trim();\n      const rStart = parseApiTime(api.rahu.start, now);\n      const rEnd = parseApiTime(api.rahu.end, now);\n      if (rStart && rEnd) {\n        base.rahu.start = rStart;\n        base.rahu.end = rEnd;\n        base.rahu.status = statusOf(base.rahu, now);\n      }\n      if (api.rahu.status && [\"now\", \"today\", \"tomorrow\"].indexOf(api.rahu.status) !== -1) {\n        base.rahu.status = api.rahu.status;\n      }\n    }\n\n    if (api.current && typeof api.current === \"object\" && api.current.name) {\n      const rawCurrentName = String(api.current.name).trim();\n      const normKey = normalizeChoghadiyaKey(rawCurrentName);\n      if (!base.current) {\n        base.current = {\n          name: normKey || \"Shubh\",\n          displayName: rawCurrentName,\n          night: base.half ? base.half.night : false,\n          marks: [],\n          start: parseApiTime(api.current.start, now) || now,\n          end: parseApiTime(api.current.end, now) || new Date(now.getTime() + 45 * 60000)\n        };\n      } else {\n        if (normKey) base.current.name = normKey;\n        base.current.displayName = rawCurrentName;\n        const cStart = parseApiTime(api.current.start, now);\n        const cEnd = parseApiTime(api.current.end, now);\n        if (cStart) base.current.start = cStart;\n        if (cEnd) base.current.end = cEnd;\n      }\n    }\n\n    if (api.festivals && Array.isArray(api.festivals)) {\n      base.festivals = api.festivals.map(String);\n    }\n    if (api.samvat && typeof api.samvat === \"string\") {\n      base.samvat = String(api.samvat);\n    }\n\n    return base;\n  }\n\n  function applyApiToDayDetails(c, api, isToday, now) {\n    if (!api || typeof api !== \"object\") {\n      c.fromApi = false;\n      return c;\n    }\n    c.fromApi = true;\n\n    \n    // Prefer server period marks / times when API provides day/night (RC 8.3.0+)\n    function mergePeriods(localArr, apiArr) {\n      if (!Array.isArray(apiArr) || !apiArr.length || !Array.isArray(localArr)) return localArr;\n      return localArr.map((p, i) => {\n        const a = apiArr[i];\n        if (!a || typeof a !== \"object\") return p;\n        const next = Object.assign({}, p);\n        if (Array.isArray(a.marks)) next.marks = a.marks.slice();\n        const ns = normalizeChoghadiyaKey(a.name || a.nameHi || \"\");\n        if (ns) next.name = ns;\n        const st = parseApiTime(a.startIso || a.start, c.day || now);\n        const en = parseApiTime(a.endIso || a.end, c.day || now);\n        if (st) next.start = st;\n        if (en) next.end = en;\n        return next;\n      });\n    }\n    if (api.day) c.dayPeriods = mergePeriods(c.dayPeriods, api.day);\n    if (api.night) c.nightPeriods = mergePeriods(c.nightPeriods, api.night);\n    if (Array.isArray(api.windows) && api.windows.length) {\n      // Server already applied clash filter\n      c.windows = api.windows.map(w => ({\n        start: parseApiTime(w.startIso || w.start, c.day || now) || now,\n        end: parseApiTime(w.endIso || w.end, c.day || now) || now,\n        names: Array.isArray(w.names) ? w.names : [w.name || \"Shubh\"].filter(Boolean)\n      })).filter(w => w.start && w.end);\n    }\n\nif (api.tithi && typeof api.tithi === \"object\" && c.tithis && c.tithis.length) {\n      if (api.tithi.name) c.tithis[0].name = String(api.tithi.name).trim();\n      if (api.tithi.number || api.tithi.n) {\n        const num = parseInt(api.tithi.number || api.tithi.n, 10);\n        if (num >= 1 && num <= 30) c.tithis[0].n = num;\n      }\n      const tEnd = parseApiTime(api.tithi.end || api.tithi.endTime, c.day);\n      if (tEnd) c.tithis[0].end = tEnd;\n    }\n\n    if (api.rahu && typeof api.rahu === \"object\") {\n      if (api.rahu.label) c.rahu.label = String(api.rahu.label).trim();\n      const rStart = parseApiTime(api.rahu.start, c.day);\n      const rEnd = parseApiTime(api.rahu.end, c.day);\n      if (rStart && rEnd) {\n        c.rahu.start = rStart;\n        c.rahu.end = rEnd;\n      }\n    }\n\n    if (api.festivals && Array.isArray(api.festivals)) {\n      c.festivals = api.festivals.map(String);\n    }\n\n    if (isToday && api.current && typeof api.current === \"object\" && api.current.name) {\n      const rawName = String(api.current.name).trim();\n      const normKey = normalizeChoghadiyaKey(rawName);\n      c.apiCurrent = {\n        rawName: rawName,\n        key: normKey,\n        start: parseApiTime(api.current.start, now),\n        end: parseApiTime(api.current.end, now)\n      };\n    }\n\n    return c;\n  }\n\n  function widgetData(now, lat, lon, apiPayload) {\n    const today = startOfDay(now);\n    const Y = dayChunk(addDays(today, -1), lat, lon);\n    const T = dayChunk(today, lat, lon);\n    const N = dayChunk(addDays(today, 1), lat, lon);\n    const timeline = [].concat(Y.nightPeriods, T.dayPeriods, T.nightPeriods, N.dayPeriods);\n    const rahu = Object.assign({}, now < T.rahu.end ? T.rahu : N.rahu);\n    rahu.status = statusOf(rahu, now);\n    const windows = goodWindows(timeline).filter(w => w.end > now).slice(0, 4);\n    windows.forEach(w => { w.status = statusOf(w, now); });\n    let half;\n    if (now < T.sun.rise) half = { night: true, chunk: Y, periods: Y.nightPeriods };\n    else if (now < T.sun.set) half = { night: false, chunk: T, periods: T.dayPeriods };\n    else half = { night: true, chunk: T, periods: T.nightPeriods };\n\n    const tithiObj = tithiAt(now);\n    const mittiObj = getHindiMitti(now, tithiObj.n);\n    const festList = getFestivals(now, tithiObj.n, mittiObj);\n\n    const base = {\n      rahu: rahu, windows: windows,\n      shubh: windows[0] || null, shubhNext: windows[1] || null, shubhThird: windows[2] || null,\n      sun: T.sun, tithi: tithiObj, mitti: mittiObj, festivals: festList, samvat: mittiObj.samvatStr,\n      half: half,\n      current: timeline.find(p => now >= p.start && now < p.end) || null,\n      upcoming: timeline.filter(p => p.end > now),\n      fromApi: false\n    };\n    return applyApiToWidgetData(base, apiPayload, now);\n  }\n\n  function dayDetails(date, lat, lon, apiPayload, nowRef) {\n    const now = nowRef || new Date();\n    const c = dayChunk(date, lat, lon);\n    c.windows = goodWindows([].concat(c.dayPeriods, c.nightPeriods));\n    c.tithis = [];\n    let t = new Date(c.sun.rise.getTime());\n    while (t < c.sunN.rise && c.tithis.length < 3) {\n      const ti = tithiAt(t);\n      c.tithis.push(ti);\n      t = new Date(ti.end.getTime() + 60000);\n    }\n    const isToday = startOfDay(date).getTime() === startOfDay(now).getTime();\n    const t0 = c.tithis[0] ? c.tithis[0].n : 1;\n    c.mitti = getHindiMitti(date, t0);\n    c.festivals = getFestivals(date, t0, c.mitti);\n    c.sankalpText = generateVedicSankalp(date, t0, c.mitti);\n    return applyApiToDayDetails(c, apiPayload, isToday, now);\n  }\n\n  function fmt(d) {\n    const p = istParts(d);\n    const h = p.hours % 12 || 12;\n    return h + \":\" + String(p.minutes).padStart(2, \"0\");\n  }\n  function fmtCountdown(ms) {\n    const s = Math.max(0, Math.floor(ms / 1000));\n    const p2 = n => String(n).padStart(2, \"0\");\n    return p2(Math.floor(s / 3600)) + \":\" + p2(Math.floor(s / 60) % 60) + \":\" + p2(s % 60);\n  }\n  function dayPart(d) {\n    const h = istParts(d).hours;\n    if (h >= 4 && h < 12) return L.subah;\n    if (h >= 12 && h < 16) return L.dopahar;\n    if (h >= 16 && h < 19) return L.shaam;\n    return L.raat;\n  }\n  function untilLabel(end, ref) {\n    return (dayOffset(end, ref) >= 1 ? L.kalPrefix : \"\") + dayPart(end) + \" \" + fmt(end);\n  }\n  function dateTitle(d) {\n    const p = istParts(d);\n    return L.WEEKDAYS[p.day] + \", \" + p.date + \" \" + L.MONTHS[p.month] + \" \" + p.year;\n  }\n\n  return {\n    LANG: LANG, L: L,\n    NAMES: L.NAMES, SHORT_NAMES: L.SHORT_NAMES, MEANING: L.MEANING, STATUS: L.STATUS,\n    TONE: TONE, SIGN: SIGN, MARK_LABEL: L.MARK_LABEL, MARK_SHORT: L.MARK_SHORT,\n    WEEKDAYS: L.WEEKDAYS, WEEKDAY_SHORT: L.WEEKDAY_SHORT, MONTHS: L.MONTHS, DAY_MS: DAY_MS,\n    istParts: istParts, fromIST: fromIST, isoDateIST: isoDateIST,\n    normalizeChoghadiyaKey: normalizeChoghadiyaKey, parseApiTime: parseApiTime,\n    getHindiMitti: getHindiMitti, getFestivals: getFestivals, generateVedicSankalp: generateVedicSankalp,\n    sunTimes: sunTimes, tithiAt: tithiAt, tithiLabel: tithiLabel, tithiShort: tithiShort, moonEmoji: moonEmoji,\n    addDays: addDays, startOfDay: startOfDay, dayOffset: dayOffset, dayChunk: dayChunk,\n    widgetData: widgetData, dayDetails: dayDetails,\n    fmt: fmt, fmtCountdown: fmtCountdown, dayPart: dayPart, untilLabel: untilLabel, dateTitle: dateTitle\n  };\n}\n\n// ===================== REMOTE PHP API CLIENT =====================\nfunction apiCacheFile() {\n  const fm = FileManager.local();\n  return { fm: fm, path: fm.joinPath(fm.cacheDirectory(), \"choghadiya-api-cache.json\") };\n}\n\nasync function fetchRemotePanchang(lat, lon, lang, dateObj) {\n  const P = panchangLib(lang);\n  const dateStr = P.isoDateIST(dateObj || new Date());\n  const url = API_ENDPOINT + \"?format=json&lat=\" + encodeURIComponent(lat) + \"&lon=\" + encodeURIComponent(lon) + \"&lang=\" + encodeURIComponent(lang) + \"&tz=\" + encodeURIComponent(TIMEZONE) + \"&date=\" + encodeURIComponent(dateStr);\n  const cache = apiCacheFile();\n\n  try {\n    const req = new Request(url);\n    req.timeoutInterval = API_TIMEOUT_SEC;\n    const rawText = await withTimeout(req.loadString(), API_TIMEOUT_SEC * 1000);\n    if (rawText && typeof rawText === \"string\") {\n      const json = JSON.parse(rawText.trim());\n      if (json && typeof json === \"object\" && (json.current || json.rahu || json.tithi || json.festivals)) {\n        try {\n          cache.fm.writeString(cache.path, JSON.stringify({\n            savedAt: Date.now(),\n            dateStr: dateStr,\n            lang: lang,\n            payload: json\n          }));\n        } catch (e) {}\n        return json;\n      }\n    }\n  } catch (e) {\n    try {\n      if (cache.fm.fileExists(cache.path)) {\n        const cached = JSON.parse(cache.fm.readString(cache.path));\n        if (cached && cached.dateStr === dateStr && (Date.now() - cached.savedAt) < 30 * 60000) {\n          return cached.payload;\n        }\n      }\n    } catch (_) {}\n  }\n  return null;\n}\n\n// ===================== PREFERENCES & LANGUAGE HELPER =====================\nfunction prefsPath() {\n  const fm = FileManager.local();\n  return { fm: fm, path: fm.joinPath(fm.documentsDirectory(), \"choghadiya-prefs.json\") };\n}\n\nfunction getSavedLanguage() {\n  const param = (args.widgetParameter || \"\").trim();\n  if (/^en/i.test(param)) return \"en-IN\";\n  if (/^hi/i.test(param)) return \"hi\";\n  const pref = prefsPath();\n  try {\n    if (pref.fm.fileExists(pref.path)) {\n      const p = JSON.parse(pref.fm.readString(pref.path));\n      if (p && p.lang) return /^en/i.test(p.lang) ? \"en-IN\" : \"hi\";\n    }\n  } catch (e) {}\n  return /^en/i.test(DEFAULT_LANGUAGE) ? \"en-IN\" : \"hi\";\n}\n\nfunction saveLanguage(lang) {\n  const pref = prefsPath();\n  try { pref.fm.writeString(pref.path, JSON.stringify({ lang: /^en/i.test(lang) ? \"en-IN\" : \"hi\" })); } catch (e) {}\n}\n\n// ===================== LOCATION HELPER =====================\nfunction withTimeout(promise, ms) {\n  let timer = null;\n  const timeoutPromise = new Promise((_, reject) => {\n    timer = Timer.schedule(ms, false, () => reject(new Error(\"timeout\")));\n  });\n  return Promise.race([promise, timeoutPromise]).finally(() => {\n    if (timer) timer.invalidate();\n  });\n}\n\nfunction distKm(a, b) {\n  const dLat = (a.lat - b.lat) * 111, dLon = (a.lon - b.lon) * 111 * Math.cos(a.lat * Math.PI / 180);\n  return Math.hypot(dLat, dLon);\n}\n\nasync function getLocation(lang) {\n  const isHi = lang === \"hi\";\n  const defaultPlace = isHi ? FALLBACK_LOCATION.placeHi : FALLBACK_LOCATION.place;\n  if (FIXED_LOCATION) {\n    return {\n      lat: FIXED_LOCATION.lat,\n      lon: FIXED_LOCATION.lon,\n      place: (isHi && FIXED_LOCATION.placeHi) ? FIXED_LOCATION.placeHi : (FIXED_LOCATION.place || defaultPlace),\n      placeEn: FIXED_LOCATION.place || FALLBACK_LOCATION.place,\n      placeHi: FIXED_LOCATION.placeHi || FALLBACK_LOCATION.placeHi\n    };\n  }\n  const fm = FileManager.local();\n  const path = fm.joinPath(fm.documentsDirectory(), \"choghadiya-location.json\");\n  let saved = null;\n  try { if (fm.fileExists(path)) saved = JSON.parse(fm.readString(path)); } catch (e) {}\n  try {\n    Location.setAccuracyToKilometer();\n    const loc = await withTimeout(Location.current(), 6000);\n    const cur = { lat: loc.latitude, lon: loc.longitude, place: \"\", placeHi: \"\" };\n    if (distKm(cur, FALLBACK_LOCATION) < 1.5) {\n      cur.place = FALLBACK_LOCATION.place;\n      cur.placeHi = FALLBACK_LOCATION.placeHi;\n    } else if (saved && saved.place && distKm(saved, cur) < 5) {\n      cur.place = saved.place;\n      cur.placeHi = saved.placeHi || saved.place;\n    } else {\n      try {\n        const gEn = await withTimeout(Location.reverseGeocode(cur.lat, cur.lon, \"en\"), 4000);\n        const aEn = gEn && gEn[0];\n        if (aEn) cur.place = aEn.locality || aEn.subAdministrativeArea || aEn.administrativeArea || \"\";\n        const gHi = await withTimeout(Location.reverseGeocode(cur.lat, cur.lon, \"hi\"), 4000);\n        const aHi = gHi && gHi[0];\n        if (aHi) cur.placeHi = aHi.locality || aHi.subAdministrativeArea || aHi.administrativeArea || cur.place;\n      } catch (e) {}\n    }\n    fm.writeString(path, JSON.stringify(cur));\n    return {\n      lat: cur.lat,\n      lon: cur.lon,\n      place: isHi ? (cur.placeHi || cur.place) : cur.place,\n      placeEn: cur.place,\n      placeHi: cur.placeHi || cur.place\n    };\n  } catch (e) {\n    return {\n      lat: FALLBACK_LOCATION.lat,\n      lon: FALLBACK_LOCATION.lon,\n      place: defaultPlace,\n      placeEn: FALLBACK_LOCATION.place,\n      placeHi: FALLBACK_LOCATION.placeHi\n    };\n  }\n}\n\n// ===================== LOGO ASSET HANDLER =====================\nfunction logoFiles() {\n  const fm = FileManager.local();\n  return { fm: fm, icon: fm.joinPath(fm.cacheDirectory(), \"arthsathi-custom-logo.png\") };\n}\n\nfunction isFresh(fm, path, days, dayMs) {\n  return fm.fileExists(path) && Date.now() - fm.modificationDate(path).getTime() < days * dayMs;\n}\n\nfunction fetchURL(url, asImage) {\n  const r = new Request(url);\n  r.timeoutInterval = 8;\n  return asImage ? r.loadImage() : r.loadString();\n}\n\nasync function widgetLogo() {\n  const lf = logoFiles();\n  if (isFresh(lf.fm, lf.icon, 7, 86400000)) return lf.fm.readImage(lf.icon);\n  for (const url of LOGO_ICONS) {\n    try {\n      const img = await fetchURL(url, true);\n      if (img && img.size.width > 0) {\n        lf.fm.writeImage(lf.icon, img);\n        return img;\n      }\n    } catch (e) {}\n  }\n  return lf.fm.fileExists(lf.icon) ? lf.fm.readImage(lf.icon) : null;\n}\n\nfunction dayViewLogoSources() {\n  const lf = logoFiles();\n  const srcs = [];\n  if (lf.fm.fileExists(lf.icon)) {\n    try { srcs.push(\"data:image/png;base64,\" + Data.fromPNG(lf.fm.readImage(lf.icon)).toBase64String()); } catch (e) {}\n  }\n  return srcs.concat(LOGO_ICONS);\n}\n\n// ===================== WIDGET UI RENDERER (OKABE-ITO COLOR-BLIND SAFE) =====================\nconst COLORS = {\n  bgTop: new Color(\"#191826\"), bgBottom: new Color(\"#0D0D14\"),\n  saffron: new Color(\"#FDE047\"), muted: new Color(\"#94A3B8\"),\n  rahuBg: new Color(\"#3B1216\"), rahuBgNow: new Color(\"#5C1920\"),\n  rahuText: new Color(\"#FCA5A5\"), rahuChip: new Color(\"#DC2626\"),\n  shubhBg: new Color(\"#0C2D48\"), shubhBgNow: new Color(\"#144266\"),\n  shubhText: new Color(\"#7DD3FC\"), shubhChip: new Color(\"#0284C7\"),\n  festBg: new Color(\"#2E1C0C\"), festText: new Color(\"#FDBA74\"), festChip: new Color(\"#EA580C\"),\n  chipIdle: new Color(\"#334155\"),\n  best: new Color(\"#FDE047\"), bestBg: new Color(\"#3B2F0B\"),\n  good: new Color(\"#7DD3FC\"), goodBg: new Color(\"#0C2D48\"),\n  neutral: new Color(\"#CBD5E1\"), neutralBg: new Color(\"#27272A\"),\n  bad: new Color(\"#FCA5A5\"), badBg: new Color(\"#3B1216\"),\n  mark: new Color(\"#FB923C\"), now: new Color(\"#FDE047\")\n};\nconst SF_ICON = {\n  Amrit: \"drop.fill\", Shubh: \"star.fill\", Labh: \"leaf.fill\", Char: \"wind\",\n  Rog: \"cross.case.fill\", Kaal: \"hourglass\", Udveg: \"bolt.fill\"\n};\nconst SF_SIGN = {\n  best: \"star.circle.fill\", good: \"checkmark.circle.fill\",\n  neutral: \"minus.circle.fill\", bad: \"xmark.circle.fill\"\n};\n\nfunction txt(stack, s, font, color, scale = 0.7) {\n  const t = stack.addText(String(s));\n  t.font = font;\n  t.textColor = color;\n  t.lineLimit = 1;\n  t.minimumScaleFactor = scale;\n  return t;\n}\n\nfunction addSym(stack, name, size, color) {\n  const s = SFSymbol.named(name) || SFSymbol.named(\"circle.fill\");\n  s.applyFont(Font.systemFont(size));\n  const img = stack.addImage(s.image);\n  img.imageSize = new Size(size + 1, size + 1);\n  img.tintColor = color;\n  return img;\n}\n\nfunction addChip(stack, text, bg, size = 9, width = 0) {\n  const chip = stack.addStack();\n  chip.backgroundColor = bg;\n  chip.cornerRadius = 6;\n  chip.setPadding(2, 5, 2, 5);\n  if (width) {\n    chip.size = new Size(width, 0);\n    chip.centerAlignContent();\n  }\n  txt(chip, text, Font.boldSystemFont(size), Color.white(), 0.6);\n}\n\nfunction addLogo(stack, logo, h, linked) {\n  const ar = logo.size.width / logo.size.height || 1;\n  const box = stack.addStack();\n  if (linked) box.url = DEV_SITE;\n  const img = box.addImage(logo);\n  img.imageSize = new Size(Math.min(h * ar, h * 3), h);\n  img.cornerRadius = Math.round(h * 0.22);\n}\n\nfunction addSunTime(P, stack, symbol, date, size = 11) {\n  addSym(stack, symbol, size + 1, COLORS.saffron);\n  stack.addSpacer(3);\n  txt(stack, P.fmt(date), Font.mediumSystemFont(size), COLORS.muted);\n}\n\nfunction widgetDims(family) {\n  const isPad = Device.isPad();\n  if (family === \"extraLarge\") return { side: 170, wide: isPad ? 715 : 680, tall: 342 };\n  if (isPad) {\n    if (family === \"large\") return { side: 170, wide: 342, tall: 342 };\n    if (family === \"medium\") return { side: 170, wide: 342, tall: 170 };\n    return { side: 155, wide: 155, tall: 155 };\n  }\n  const s = Device.screenSize();\n  const w = Math.min(s.width, s.height), h = Math.max(s.width, s.height);\n  const TABLE = [\n    [428, 0, 170, 364, 382], [414, 896, 169, 360, 379], [414, 0, 159, 348, 357],\n    [390, 0, 158, 338, 354], [375, 812, 155, 329, 345], [375, 0, 148, 321, 324], [0, 0, 141, 292, 311]\n  ];\n  const row = TABLE.find(r => w >= r[0] && h >= r[1]);\n  return { side: row[2], wide: row[3], tall: row[4] };\n}\n\nfunction getSizeConfig(P) {\n  return {\n    small:  { pad: 5, label: 11, sub: 9.5, part: 9,  time: 13.5, extra: 8.5, chip: P.L.chipShort, chipFont: 8,   icon: 11 },\n    medium: { pad: 6, label: 11, sub: 10,  part: 10, time: 15,   extra: 10,  chip: P.L.chipShort, chipFont: 8.5, icon: 11 },\n    large:  { pad: 8, label: 13, sub: 10.5, part: 11, time: 18,  extra: 10,  chip: P.L.chip,      chipFont: 9,    icon: 13 }\n  };\n}\n\nfunction addBlock(P, c, o, z, width = 0) {\n  const live = o.status === \"now\";\n  const box = c.addStack();\n  box.layoutVertically();\n  box.backgroundColor = live ? o.bgNow : o.bg;\n  box.cornerRadius = 12;\n  box.setPadding(z.pad, 9, z.pad, 9);\n  if (width) box.size = new Size(width, 0);\n\n  const top = box.addStack();\n  top.layoutHorizontally();\n  top.centerAlignContent();\n  addSym(top, o.sign, z.icon, o.text);\n  top.addSpacer(4);\n  txt(top, o.label, Font.boldSystemFont(z.label), o.text);\n  if (o.sub) txt(top, \" · \" + o.sub, Font.systemFont(z.sub), o.text, 0.6).textOpacity = 0.85;\n  top.addSpacer();\n  addChip(top, z.chip[o.status], live ? o.chip : COLORS.chipIdle, z.chipFont);\n\n  box.addSpacer(1);\n  const row = box.addStack();\n  row.layoutHorizontally();\n  row.bottomAlignContent();\n  if (o.customLabel) {\n    txt(row, o.customLabel, Font.boldRoundedSystemFont(z.time), Color.white(), 0.6);\n  } else {\n    txt(row, P.dayPart(o.start) + \" \", Font.systemFont(z.part), COLORS.muted);\n    txt(row, P.fmt(o.start) + \" – \" + P.fmt(o.end), Font.boldRoundedSystemFont(z.time), Color.white(), 0.6);\n  }\n  row.addSpacer();\n\n  if (o.extra) txt(box, o.extra, Font.systemFont(z.extra), o.text, 0.7).textOpacity = 0.85;\n}\n\nfunction rahuBlock(P, data, sub, extra) {\n  return {\n    label: P.L.rahuTitle, sub: sub, extra: extra, sign: SF_SIGN.bad,\n    start: data.rahu.start, end: data.rahu.end, status: data.rahu.status,\n    customLabel: data.rahu.label || null,\n    bg: COLORS.rahuBg, bgNow: COLORS.rahuBgNow, text: COLORS.rahuText, chip: COLORS.rahuChip\n  };\n}\n\nfunction shubhBlock(P, win, sub, extra) {\n  return {\n    label: P.L.shubhTitle, sub: sub, extra: extra, sign: win.names.indexOf(\"Amrit\") !== -1 ? SF_SIGN.best : SF_SIGN.good,\n    start: win.start, end: win.end, status: win.status,\n    bg: COLORS.shubhBg, bgNow: COLORS.shubhBgNow, text: COLORS.shubhText, chip: COLORS.shubhChip\n  };\n}\n\nconst winNames = (P, w) => w.names.map(n => P.SHORT_NAMES[n]).join(\" + \");\n\nfunction addCapsule(P, c, p, now, w, h, currentOverride) {\n  const on = now >= p.start && now < p.end;\n  const effKey = (on && currentOverride && currentOverride.name) ? currentOverride.name : p.name;\n  const isAfflicted = p.marks && p.marks.length > 0;\n  const tone = isAfflicted ? \"bad\" : (P.TONE[effKey] || P.TONE[p.name]);\n  const displayTitle = (on && currentOverride && currentOverride.displayName)\n    ? currentOverride.displayName\n    : P.NAMES[effKey];\n\n  const cap = c.addStack();\n  cap.layoutVertically();\n  cap.size = new Size(w, h);\n  cap.backgroundColor = COLORS[tone + \"Bg\"];\n  cap.cornerRadius = 8;\n  cap.setPadding(3, 5, 3, 5);\n  if (on) {\n    cap.borderWidth = 1.5;\n    cap.borderColor = COLORS.now;\n  }\n  const r1 = cap.addStack();\n  r1.layoutHorizontally();\n  r1.centerAlignContent();\n  addSym(r1, SF_ICON[effKey] || \"circle.fill\", 9, COLORS[tone]);\n  r1.addSpacer(3);\n  txt(r1, displayTitle, Font.boldSystemFont(10), COLORS[tone], 0.6);\n  r1.addSpacer();\n  txt(r1, isAfflicted ? \"✕\" : P.SIGN[tone], Font.boldSystemFont(9), COLORS[tone]);\n  cap.addSpacer();\n  const r2 = cap.addStack();\n  r2.layoutHorizontally();\n  r2.centerAlignContent();\n  if (on) txt(r2, P.L.nowWord, Font.boldSystemFont(9), COLORS.now);\n  else txt(r2, P.fmt(p.start), Font.mediumMonospacedSystemFont(9), COLORS.muted);\n  r2.addSpacer();\n  if (p.marks.length) {\n    const mStr = p.marks.map(m => P.MARK_SHORT[m]).join(\"+\");\n    txt(r2, mStr, Font.boldSystemFont(7.5), COLORS.mark, 0.55);\n  }\n}\n\nfunction addCapsuleRow(P, c, periods, now, innerW, h, currentOverride) {\n  if (!periods || !periods.length) return;\n  const gap = 4, n = periods.length;\n  const w = Math.floor((innerW - gap * (n - 1)) / n);\n  const row = c.addStack();\n  row.layoutHorizontally();\n  periods.forEach((p, i) => {\n    if (i) row.addSpacer(gap);\n    addCapsule(P, row, p, now, w, h, currentOverride);\n  });\n}\n\n// ---------- Small (2x2) ----------\nfunction renderSmall(P, w, data, now, logo, dims, SIZES) {\n  const z = SIZES.small, t = data.tithi, np = P.istParts(now);\n  w.setPadding(10, 10, 10, 10);\n\n  const head = w.addStack();\n  head.layoutHorizontally();\n  head.centerAlignContent();\n  txt(head, P.moonEmoji(t.n) + \" \" + P.tithiShort(t.n, t.name), Font.boldSystemFont(12), COLORS.saffron, 0.65);\n  head.addSpacer();\n  if (logo) addLogo(head, logo, 18, false);\n\n  const subLine = (data.festivals && data.festivals.length)\n    ? \"🪔 \" + data.festivals[0]\n    : data.mitti.monthName + \" · \" + P.L.endsLabel + \" \" + P.untilLabel(t.end, now);\n  txt(w, P.WEEKDAY_SHORT[np.day] + \" \" + np.date + \" · \" + subLine, Font.systemFont(8.5), COLORS.muted, 0.65);\n\n  w.addSpacer();\n  addBlock(P, w, rahuBlock(P, data, null, P.L.rahuAvoid), z);\n  if (data.shubh) {\n    w.addSpacer(4);\n    addBlock(P, w, shubhBlock(P, data.shubh, null, winNames(P, data.shubh)), z);\n  }\n}\n\n// ---------- Medium (4x2) ----------\nfunction renderMedium(P, w, data, now, logo, dims, SIZES) {\n  const z = SIZES.medium, t = data.tithi, np = P.istParts(now);\n  const innerW = dims.wide - 24;\n  w.setPadding(10, 12, 10, 12);\n\n  const head = w.addStack();\n  head.layoutHorizontally();\n  head.centerAlignContent();\n  txt(head, P.moonEmoji(t.n) + \" \" + P.tithiLabel(t.n, t.name), Font.boldSystemFont(12.5), COLORS.saffron, 0.7);\n  head.addSpacer(6);\n  txt(head, P.WEEKDAY_SHORT[np.day] + \" \" + np.date + \" (\" + data.mitti.monthName + \")\", Font.systemFont(10), COLORS.muted);\n  head.addSpacer();\n  if (logo) addLogo(head, logo, 18, true);\n\n  w.addSpacer(2);\n  const sub = w.addStack();\n  sub.layoutHorizontally();\n  sub.centerAlignContent();\n\n  const festTxt = (data.festivals && data.festivals.length) ? \"🪔 \" + data.festivals.slice(0, 2).join(\" · \") : data.mitti.fullMitti;\n  txt(sub, festTxt, Font.semiboldSystemFont(9.5), (data.festivals && data.festivals.length) ? COLORS.festText : COLORS.muted, 0.65);\n  sub.addSpacer();\n  addSunTime(P, sub, \"sunrise.fill\", data.sun.rise, 10);\n  sub.addSpacer(8);\n  addSunTime(P, sub, \"sunset.fill\", data.sun.set, 10);\n\n  w.addSpacer();\n  const blocks = w.addStack();\n  blocks.layoutHorizontally();\n  const bw = data.shubh ? Math.floor((innerW - 6) / 2) : innerW;\n  addBlock(P, blocks, rahuBlock(P, data, null, P.L.rahuAvoid), z, bw);\n  if (data.shubh) {\n    blocks.addSpacer(6);\n    addBlock(P, blocks, shubhBlock(P, data.shubh, null, winNames(P, data.shubh)), z, bw);\n  }\n\n  w.addSpacer();\n  addCapsuleRow(P, w, data.upcoming.slice(0, 4), now, innerW, 30, data.current);\n}\n\n// ---------- Large (4x4) & Extra Large (4x6 iPadOS) ----------\nfunction renderLarge(P, w, data, now, logo, dims, family, SIZES) {\n  const z = SIZES.large, t = data.tithi, half = data.half, c = half.chunk, np = P.istParts(now);\n  const innerW = dims.wide - 24;\n  const isXL = family === \"extraLarge\";\n  const maxWins = isXL ? 4 : dims.tall >= 350 ? 3 : 2;\n  w.setPadding(12, 12, 12, 12);\n\n  const head = w.addStack();\n  head.layoutHorizontally();\n  head.centerAlignContent();\n  txt(head, P.moonEmoji(t.n) + \" \" + P.tithiLabel(t.n, t.name), Font.boldSystemFont(15), COLORS.saffron, 0.7);\n  head.addSpacer(6);\n  txt(head, \"· \" + data.mitti.monthName + \" Maas\", Font.systemFont(11), COLORS.muted);\n  head.addSpacer();\n  if (logo) addLogo(head, logo, 24, true);\n\n  w.addSpacer(2);\n  const sub = w.addStack();\n  sub.layoutHorizontally();\n  sub.centerAlignContent();\n  txt(sub, P.WEEKDAYS[np.day] + \", \" + np.date + \" \" + P.MONTHS[np.month] + \" · \" + data.mitti.samvatStr,\n    Font.systemFont(10.5), COLORS.muted, 0.7);\n  sub.addSpacer();\n  addSunTime(P, sub, \"sunrise.fill\", data.sun.rise, 11);\n  sub.addSpacer(10);\n  addSunTime(P, sub, \"sunset.fill\", data.sun.set, 11);\n\n  if (data.festivals && data.festivals.length) {\n    w.addSpacer(3);\n    const festBar = w.addStack();\n    festBar.layoutHorizontally();\n    festBar.centerAlignContent();\n    festBar.backgroundColor = COLORS.festBg;\n    festBar.cornerRadius = 6;\n    festBar.setPadding(2, 6, 2, 6);\n    txt(festBar, \"🪔 \" + data.festivals.join(\"  ·  \"), Font.boldSystemFont(10), COLORS.festText, 0.7);\n  }\n\n  w.addSpacer();\n\n  let leftCol = w, rightCol = w, colW = innerW;\n  if (isXL) {\n    const body = w.addStack();\n    body.layoutHorizontally();\n    colW = Math.floor((innerW - 12) / 2);\n    leftCol = body.addStack();\n    leftCol.layoutVertically();\n    leftCol.size = new Size(colW, 0);\n    body.addSpacer(12);\n    rightCol = body.addStack();\n    rightCol.layoutVertically();\n    rightCol.size = new Size(colW, 0);\n  }\n\n  addBlock(P, leftCol, rahuBlock(P, data, P.L.rahuAvoid), z);\n  leftCol.addSpacer(isXL ? 8 : 5);\n\n  const card = leftCol.addStack();\n  card.layoutVertically();\n  card.backgroundColor = COLORS.shubhBg;\n  card.cornerRadius = 12;\n  card.setPadding(7, 9, 7, 9);\n  const title = card.addStack();\n  title.layoutHorizontally();\n  title.centerAlignContent();\n  addSym(title, SF_SIGN.good, 12, COLORS.shubhText);\n  title.addSpacer(4);\n  txt(title, P.L.shubhWindowsTitle, Font.boldSystemFont(12.5), COLORS.shubhText);\n  title.addSpacer();\n  txt(title, P.L.startWork, Font.systemFont(9.5), COLORS.shubhText).textOpacity = 0.8;\n  const wins = data.windows.slice(0, maxWins);\n  wins.forEach(win => {\n    card.addSpacer(3);\n    const live = win.status === \"now\";\n    const row = card.addStack();\n    row.layoutHorizontally();\n    row.centerAlignContent();\n    addSym(row, win.names.indexOf(\"Amrit\") !== -1 ? SF_SIGN.best : SF_SIGN.good, 11,\n      win.names.indexOf(\"Amrit\") !== -1 ? COLORS.best : COLORS.shubhText);\n    row.addSpacer(5);\n    txt(row, winNames(P, win), Font.semiboldSystemFont(11), COLORS.shubhText, 0.6);\n    row.addSpacer();\n    txt(row, P.dayPart(win.start) + \" \", Font.systemFont(10), COLORS.muted);\n    txt(row, P.fmt(win.start) + \" – \" + P.fmt(win.end), Font.boldRoundedSystemFont(13.5), Color.white(), 0.7);\n    row.addSpacer(6);\n    addChip(row, P.L.chipShort[win.status], live ? COLORS.shubhChip : COLORS.chipIdle, 8, 42);\n  });\n  if (!wins.length) {\n    card.addSpacer(3);\n    txt(card, P.L.noWindow24, Font.systemFont(10.5), COLORS.shubhText);\n  }\n\n  if (!isXL) w.addSpacer();\n  const sec = rightCol.addStack();\n  sec.layoutHorizontally();\n  sec.centerAlignContent();\n  txt(sec, half.night ? P.L.nightChoghadiya : P.L.dayChoghadiya, Font.boldSystemFont(11), COLORS.saffron);\n  sec.addSpacer();\n  txt(sec, half.night\n    ? P.L.sunsetLabel + \" \" + P.fmt(c.sun.set) + \" – \" + P.L.sunriseLabel + \" \" + P.fmt(c.sunN.rise)\n    : P.L.sunriseLabel + \" \" + P.fmt(c.sun.rise) + \" – \" + P.L.sunsetLabel + \" \" + P.fmt(c.sun.set), Font.systemFont(10), COLORS.muted);\n  rightCol.addSpacer(3);\n  addCapsuleRow(P, rightCol, half.periods.slice(0, 4), now, colW, isXL ? 46 : 30, data.current);\n  rightCol.addSpacer(3);\n  addCapsuleRow(P, rightCol, half.periods.slice(4), now, colW, isXL ? 46 : 30, data.current);\n}\n\nfunction render(P, data, now, logo, family, dims) {\n  const w = new ListWidget();\n  const g = new LinearGradient();\n  g.colors = [COLORS.bgTop, COLORS.bgBottom];\n  g.locations = [0, 1];\n  w.backgroundGradient = g;\n  w.url = URLScheme.forRunningScript();\n  const SIZES = getSizeConfig(P);\n\n  if (family === \"large\" || family === \"extraLarge\") renderLarge(P, w, data, now, logo, dims, family, SIZES);\n  else if (family === \"medium\") renderMedium(P, w, data, now, logo, dims, SIZES);\n  else renderSmall(P, w, data, now, logo, dims, SIZES);\n\n  const midnight = P.addDays(P.startOfDay(now), 1);\n  const marks = [data.rahu.start, data.rahu.end, data.tithi.end, midnight];\n  data.windows.slice(0, 3).forEach(x => marks.push(x.start, x.end));\n  if (data.current) marks.push(data.current.end);\n  const next = Math.min(...marks.map(d => d.getTime()).filter(x => x > now.getTime()), now.getTime() + 15 * 60000);\n  w.refreshAfterDate = new Date(next + 30000);\n  return w;\n}\n\n// ===================== DAY VIEW INTERFACE (RESPONSIVE IPAD & VEDIC SANKALP) =====================\nfunction dayViewPage(panchangFactory, initialLang, LAT, LON, PLACE_EN, PLACE_HI, initialApiData, apiEndpointUrl) {\n  const $ = id => document.getElementById(id);\n  const esc = s => String(s).replace(/[&<>\"']/g, c => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" }[c]));\n\n  let currentLang = initialLang;\n  let P = panchangFactory(currentLang);\n  let cur = P.startOfDay(new Date());\n  let liveEnd = null;\n  const apiCache = {};\n\n  if (initialApiData && typeof initialApiData === \"object\") {\n    apiCache[P.isoDateIST(cur) + \":\" + currentLang] = initialApiData;\n  }\n\n  const iso = d => P.isoDateIST(d);\n  const range = (a, b) => '<span class=\"part\">' + P.dayPart(a) + '</span> ' + P.fmt(a) + ' – ' + P.fmt(b);\n  const nowChip = on => on ? '<span class=\"nowchip\">● ' + P.L.chip.now + '</span>' : \"\";\n\n  const svg = (inner, fill) => '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"' + (fill ? \"currentColor\" : \"none\") + '\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">' + inner + '</svg>';\n  const ICON = {\n    Amrit: svg('<path d=\"M12 3C8.5 7.6 6 10.9 6 14a6 6 0 0 0 12 0c0-3.1-2.5-6.4-6-11z\"/>', true),\n    Shubh: svg('<path d=\"M12 3l2.7 5.9 6.3.7-4.8 4.3 1.4 6.3L12 17l-5.6 3.2 1.4-6.3L3 9.6l6.3-.7z\"/>', true),\n    Labh: svg('<path d=\"M12 21v-9\"/><path d=\"M12 12C12 8 9 6 5 6c0 4 3 6 7 6z\"/><path d=\"M12 10c0-3.5 2.5-5.5 6.5-5.5 0 3.5-2.5 5.5-6.5 5.5z\"/>', false),\n    Char: svg('<path d=\"M3 8h10a3 3 0 1 0-3-3\"/><path d=\"M3 12h15a3 3 0 1 1-3 3\"/><path d=\"M3 16h7\"/>', false),\n    Rog: svg('<rect x=\"3\" y=\"7\" width=\"18\" height=\"13\" rx=\"2\"/><path d=\"M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2\"/><path d=\"M12 10.5v6M9 13.5h6\"/>', false),\n    Kaal: svg('<path d=\"M6 3h12M6 21h12\"/><path d=\"M7 3c0 5 5 6 5 9s-5 4-5 9M17 3c0 5-5 6-5 9s5 4 5 9\"/>', false),\n    Udveg: svg('<path d=\"M13 2L4 14h7l-1 8 9-12h-7z\"/>', true)\n  };\n  const MARK_ICON = {\n    rahu: svg('<circle cx=\"12\" cy=\"12\" r=\"8\"/><path d=\"M12 4a8 8 0 0 1 0 16a4.5 8 0 0 0 0-16z\" fill=\"currentColor\"/>', false),\n    vela: svg('<path d=\"M8 3h8l5 5v8l-5 5H8l-5-5V8z\"/><path d=\"M9.5 9.5l5 5M14.5 9.5l-5 5\"/>', false)\n  };\n  const tone = n => P.TONE[n] || \"neutral\";\n  const badge = n => '<span class=\"badge\">' + P.SIGN[tone(n)] + ' ' + P.STATUS[n] + '</span>';\n  const markTags = p => p.marks.map(m =>\n    '<span class=\"mk\">' + (m === \"rahu\" ? MARK_ICON.rahu : MARK_ICON.vela) + P.MARK_LABEL[m] + '</span>').join(\"\");\n\n  async function loadApiForDate(d, lang) {\n    const key = P.isoDateIST(d) + \":\" + lang;\n    if (apiCache[key]) return apiCache[key];\n    try {\n      const url = apiEndpointUrl + \"?format=json&lat=\" + encodeURIComponent(LAT) + \"&lon=\" + encodeURIComponent(LON) + \"&lang=\" + encodeURIComponent(lang) + \"&tz=Asia/Kolkata&date=\" + encodeURIComponent(P.isoDateIST(d));\n      const res = await fetch(url, { headers: { \"Accept\": \"application/json\" } });\n      if (res.ok) {\n        const j = await res.json();\n        if (j && (j.current || j.rahu || j.tithi || j.festivals)) {\n          apiCache[key] = j;\n          return j;\n        }\n      }\n    } catch (e) {}\n    return null;\n  }\n\n  function relLabel(n) {\n    if (n === 0) return P.L.relToday;\n    if (n === 1) return P.L.relTomorrow;\n    if (n === -1) return P.L.relYesterday;\n    return n > 0 ? P.L.relLater(n) : P.L.relAgo(-n);\n  }\n\n  function rowHTML(p, now, apiCurrent) {\n    const on = now >= p.start && now < p.end, past = p.end <= now;\n    const effKey = (on && apiCurrent && apiCurrent.key) ? apiCurrent.key : p.name;\n    const displayTitle = (on && apiCurrent && apiCurrent.rawName) ? esc(apiCurrent.rawName) : P.NAMES[effKey];\n    const isAfflicted = p.marks && p.marks.length > 0;\n    const effTone = isAfflicted ? \"bad\" : tone(effKey);\n    const badgeHTML = isAfflicted\n      ? '<span class=\"badge\" style=\"color:var(--bad-txt); border-color:var(--bad-border);\">✕ ' + P.L.inauspiciousDueToRahu + '</span>'\n      : badge(effKey);\n\n    const mksBlock = (on || p.marks.length)\n      ? '<div class=\"mks\">' + (on ? '<span class=\"nowchip\">● ' + P.L.chip.now + '</span>' : \"\") + markTags(p) + '</div>'\n      : \"\";\n    return '<div class=\"row ' + effTone + (on ? \" on\" : \"\") + (past ? \" past\" : \"\") + '\">' +\n      '<span class=\"ic\">' + ICON[effKey] + '</span>' +\n      '<div class=\"nm\">' +\n        '<div class=\"ch-name\">' + displayTitle + '</div>' +\n        '<div class=\"ch-en\">' + P.SHORT_NAMES[effKey] + ' – ' + (isAfflicted ? P.L.inauspiciousDueToRahu : P.MEANING[effKey]) + '</div>' +\n        mksBlock +\n      '</div>' +\n      '<div class=\"tm\">' + P.fmt(p.start) + ' – ' + P.fmt(p.end) + '</div>' +\n      badgeHTML +\n    '</div>';\n  }\n\n  function liveHTML(now, todayApi) {\n    const T = P.dayChunk(now, LAT, LON), Y = P.dayChunk(P.addDays(now, -1), LAT, LON);\n    const p = [].concat(Y.nightPeriods, T.dayPeriods, T.nightPeriods).find(q => now >= q.start && now < q.end);\n    if (!p && !(todayApi && todayApi.current && todayApi.current.name)) {\n      liveEnd = null;\n      return \"\";\n    }\n    const apiCurName = todayApi && todayApi.current && todayApi.current.name ? String(todayApi.current.name).trim() : null;\n    const effKey = (apiCurName && P.normalizeChoghadiyaKey(apiCurName)) || (p ? p.name : \"Shubh\");\n    const cStart = (todayApi && todayApi.current && P.parseApiTime(todayApi.current.start, now)) || (p ? p.start : now);\n    const cEnd = (todayApi && todayApi.current && P.parseApiTime(todayApi.current.end, now)) || (p ? p.end : new Date(now.getTime() + 45 * 60000));\n    liveEnd = cEnd;\n    const preDawn = now < T.sun.rise;\n    const isAfflicted = p && p.marks && p.marks.length > 0;\n    const effTone = isAfflicted ? \"bad\" : tone(effKey);\n    const sign = isAfflicted ? \"✕\" : P.SIGN[effTone];\n\n    let headline = apiCurName ? esc(apiCurName) + \" (\" + P.MEANING[effKey] + \")\" : P.SHORT_NAMES[effKey] + \" – \" + P.MEANING[effKey];\n    if (isAfflicted) {\n      headline = (apiCurName ? esc(apiCurName) : P.SHORT_NAMES[effKey]) + \" [\" + P.L.inauspiciousDueToRahu + \"]\";\n    }\n\n    return '<section class=\"live ' + effTone + '\">' +\n      '<span class=\"ic\">' + ICON[effKey] + '</span>' +\n      '<div class=\"lv\">' +\n        '<small>' + P.L.liveBannerTitle + (preDawn ? P.L.prevNightNote : \"\") + '</small>' +\n        '<b>' + sign + ' ' + headline + '</b>' +\n        '<span>' + range(cStart, cEnd) + '</span>' +\n        (p && p.marks.length ? '<div class=\"mks\">' + markTags(p) + '</div>' : \"\") +\n      '</div>' +\n      '<div class=\"cd\"><small>' + P.L.timeLeft + '</small><b id=\"cd\">' + P.fmtCountdown(cEnd - now) + '</b></div>' +\n    '</section>';\n  }\n\n  function weekHTML(now) {\n    const t0 = P.startOfDay(now);\n    const off = Math.round((cur - t0) / P.DAY_MS);\n    const start = P.addDays(t0, Math.floor(off / 7) * 7);\n    let h = \"\";\n    for (let i = 0; i < 7; i++) {\n      const d = P.addDays(start, i);\n      const dp = P.istParts(d);\n      const sel = d.getTime() === cur.getTime(), isToday = d.getTime() === t0.getTime();\n      h += '<button class=\"wd' + (sel ? \" sel\" : \"\") + (isToday ? \" today\" : \"\") + '\" data-t=\"' + d.getTime() + '\">' +\n        '<span>' + P.WEEKDAY_SHORT[dp.day] + '</span><b>' + dp.date + '</b></button>';\n    }\n    return h;\n  }\n\n  function show() {\n    const now = new Date(), t0 = P.startOfDay(now);\n    const activeKey = P.isoDateIST(cur) + \":\" + currentLang;\n    const todayKey = P.isoDateIST(t0) + \":\" + currentLang;\n    const activeApi = apiCache[activeKey] || apiCache[P.isoDateIST(cur) + \":hi\"] || null;\n    const todayApi = apiCache[todayKey] || apiCache[P.isoDateIST(t0) + \":hi\"] || activeApi;\n\n    const d = P.dayDetails(cur, LAT, LON, activeApi, now);\n    const n = Math.round((cur - t0) / P.DAY_MS);\n    const live = x => now >= x.start && now < x.end;\n    const placeName = currentLang === \"hi\" ? (PLACE_HI || PLACE_EN) : PLACE_EN;\n\n    $(\"date\").textContent = P.dateTitle(cur);\n    $(\"rel\").textContent = relLabel(n) + (placeName ? \" · 📍 \" + placeName : \"\");\n    $(\"today\").textContent = P.L.goToday;\n    $(\"today\").classList.toggle(\"hide\", n === 0);\n    $(\"pickText\").textContent = P.L.selectDate;\n    $(\"langBtn\").textContent = P.L.toggleBtn;\n    $(\"devBy\").textContent = P.L.devBy;\n    $(\"picker\").value = iso(cur);\n    $(\"week\").innerHTML = weekHTML(now);\n    $(\"live\").innerHTML = liveHTML(now, todayApi);\n\n    const t = d.tithis[0];\n    const more = d.tithis.slice(1)\n      .map(x => '<div class=\"muted\">' + P.L.phirLabel + ': ' + esc(P.tithiLabel(x.n, x.name)) + ' · ' + P.L.endsLabel + ' ' + P.untilLabel(x.end, d.sun.rise) + '</div>').join(\"\");\n\n    const wins = d.windows.length\n      ? d.windows.map(x => '<div class=\"win' + (live(x) ? \" on\" : \"\") + (x.end <= now ? \" past\" : \"\") + '\">' +\n          '<span class=\"sg\">' + (x.names.indexOf(\"Amrit\") !== -1 ? \"★\" : \"✓\") + '</span>' +\n          '<span class=\"wn\">' + x.names.map(k => P.SHORT_NAMES[k]).join(\" + \") + ' ' + nowChip(live(x)) + '</span>' +\n          '<span class=\"wt\">' + range(x.start, x.end) + '</span>' +\n        '</div>').join(\"\")\n      : '<div class=\"muted\">' + P.L.noWindowDay + '</div>';\n\n    const rahuDisplay = d.rahu.label ? esc(d.rahu.label) : range(d.rahu.start, d.rahu.end);\n    const srcText = d.fromApi ? P.L.apiBadgeLive : P.L.apiBadgeLocal;\n\n    const festsHTML = (d.festivals && d.festivals.length)\n      ? d.festivals.map(f => '<span class=\"fpill\">🪔 ' + esc(f) + '</span>').join(\"\")\n      : '<span class=\"muted\">' + P.L.noFestival + '</span>';\n\n    $(\"out\").innerHTML =\n      '<div class=\"grid-wrap\">' +\n        '<div class=\"grid-col\">' +\n          '<section class=\"card fest-card\">' +\n            '<div class=\"hd\" style=\"color:var(--fest-txt); margin-bottom:6px;\"><span class=\"sg\">🪔</span> ' + P.L.festivalsTitle + '</div>' +\n            '<div class=\"fest-list\">' + festsHTML + '</div>' +\n          '</section>' +\n\n          '<section class=\"card sankalp-card\">' +\n            '<div class=\"sankalp-title\">' + P.L.sankalpTitle + '</div>' +\n            '<div class=\"sankalp-body\">' + d.sankalpText + '</div>' +\n          '</section>' +\n\n          '<section class=\"card tithi\">' +\n            '<div class=\"moon\">' + P.moonEmoji(t.n) + '</div>' +\n            '<div class=\"tinfo\">' +\n              '<div class=\"tname\">' + esc(P.tithiLabel(t.n, t.name)) + '</div>' +\n              '<div class=\"sm-mitti\"><b>' + esc(d.mitti.fullMitti) + '</b></div>' +\n              '<div class=\"sm-samvat\">' + esc(d.mitti.samvatStr) + '</div>' +\n              '<div class=\"muted\">' + P.L.endsLabel + ': ' + P.untilLabel(t.end, d.sun.rise) + '</div>' +\n              more +\n            '</div>' +\n          '</section>' +\n          '<div class=\"sun\">' +\n            '<span>🌅 ' + P.L.sunriseLabel + ' <b>' + P.fmt(d.sun.rise) + '</b></span>' +\n            '<span>🌇 ' + P.L.sunsetLabel + ' <b>' + P.fmt(d.sun.set) + '</b></span>' +\n          '</div>' +\n          '<section class=\"card rahu' + (live(d.rahu) ? \" on\" : \"\") + '\">' +\n            '<div class=\"hd\"><span class=\"sg\">✕</span> ' + P.L.rahuTitle + ' <small>· ' + P.L.rahuAvoidLong + '</small> ' + nowChip(live(d.rahu)) + '</div>' +\n            '<div class=\"big\">' + rahuDisplay + '</div>' +\n          '</section>' +\n          '<section class=\"card shubh\">' +\n            '<div class=\"hd\"><span class=\"sg\">✓</span> ' + P.L.shubhWindowsTitle + ' <small>· ' + P.L.startWork + '</small></div>' +\n            wins +\n          '</section>' +\n        '</div>' +\n\n        '<div class=\"grid-col\">' +\n          '<section class=\"card ch-card\">' +\n            '<div class=\"ch-header\"><span>' + P.L.dayChoghadiya + '</span><span class=\"sun-time\">' + P.L.sunriseLabel + ' – ' + P.fmt(d.sun.rise) + '</span></div>' +\n            '<div class=\"ch-table\">' + d.dayPeriods.map(p => rowHTML(p, now, d.apiCurrent)).join(\"\") + '</div>' +\n          '</section>' +\n          '<section class=\"card ch-card\">' +\n            '<div class=\"ch-header\"><span>' + P.L.nightChoghadiya + '</span><span class=\"sun-time\">' + P.L.sunsetLabel + ' – ' + P.fmt(d.sun.set) + '</span></div>' +\n            '<div class=\"ch-table\">' + d.nightPeriods.map(p => rowHTML(p, now, d.apiCurrent)).join(\"\") + '</div>' +\n          '</section>' +\n          '<section class=\"card note-card\">' +\n            '<p>' + P.L.note1 + '</p>' +\n            '<p>' + P.L.note2 + '</p>' +\n            (placeName ? '<p>' + P.L.noteLoc(esc(placeName), LAT.toFixed(5), LON.toFixed(5), srcText) + '</p>' : \"\") +\n          '</section>' +\n        '</div>' +\n      '</div>';\n  }\n\n  async function navigateAndRefresh(newDate) {\n    cur = newDate;\n    show();\n    const fetched = await loadApiForDate(cur, currentLang);\n    if (fetched) show();\n  }\n\n  setInterval(() => {\n    if (!liveEnd) return;\n    const now = new Date();\n    if (now >= liveEnd) { show(); return; }\n    const el = $(\"cd\");\n    if (el) el.textContent = P.fmtCountdown(liveEnd - now);\n  }, 1000);\n\n  const go = k => navigateAndRefresh(P.addDays(cur, k));\n  $(\"prev\").onclick = () => go(-1);\n  $(\"next\").onclick = () => go(1);\n  $(\"today\").onclick = () => navigateAndRefresh(P.startOfDay(new Date()));\n  $(\"picker\").onchange = e => {\n    const parts = e.target.value.split(\"-\").map(Number);\n    if (parts[0]) navigateAndRefresh(P.fromIST(parts[0], parts[1] - 1, parts[2], 0, 0));\n  };\n  $(\"langBtn\").onclick = async () => {\n    currentLang = currentLang === \"hi\" ? \"en-IN\" : \"hi\";\n    P = panchangFactory(currentLang);\n    show();\n    const iframe = document.createElement(\"iframe\");\n    iframe.style.display = \"none\";\n    iframe.src = \"scriptable-lang://\" + currentLang;\n    document.body.appendChild(iframe);\n    setTimeout(() => iframe.remove(), 200);\n    const fetched = await loadApiForDate(cur, currentLang);\n    if (fetched) show();\n  };\n  $(\"week\").onclick = e => {\n    const b = e.target.closest(\".wd\");\n    if (b) navigateAndRefresh(new Date(Number(b.dataset.t)));\n  };\n  let x0 = null, y0 = null;\n  document.addEventListener(\"touchstart\", e => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });\n  document.addEventListener(\"touchend\", e => {\n    if (x0 === null) return;\n    const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;\n    if (Math.abs(dx) > 70 && Math.abs(dy) < 50) go(dx < 0 ? 1 : -1);\n    x0 = null;\n  });\n  show();\n}\n\nfunction escapeHTML(s) {\n  return String(s).replace(/[&<>\"']/g, c => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" }[c]));\n}\n\nfunction dayViewHTML(lang, lat, lon, placeEn, placeHi, logoSources, apiPayload) {\n  return `<!doctype html>\n<html lang=\"${escapeHTML(lang)}\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Choghadiya & Panchang</title>\n<style>\n  :root {\n    color-scheme: light dark;\n    --bg: #0F1016; --bg2: #181A24; --card: #14161F; --line: #262938;\n    --text: #F1F5F9; --muted: #94A3B8; --saffron: #FDE047;\n    --bad-bg: #3B1216; --bad-txt: #FCA5A5; --bad-border: #DC2626;\n    --good-bg: #0C2D48; --good-txt: #7DD3FC; --good-border: #0284C7;\n    --best-bg: #3B2F0B; --best-txt: #FDE047; --best-border: #EAB308;\n    --neutral-bg: #222530; --neutral-txt: #CBD5E1; --neutral-border: #64748B;\n    --fest-bg: #2A170A; --fest-txt: #FDBA74; --fest-border: #EA580C;\n    --sankalp-bg: #1B1824; --sankalp-border: #EAB308;\n    --mark: #FB923C;\n  }\n  @media (prefers-color-scheme: light) {\n    :root {\n      --bg: #F8F4EC; --bg2: #EFE6D5; --card: #FFFFFF; --line: #E2D5BE;\n      --text: #1E293B; --muted: #64748B; --saffron: #B45309;\n      --bad-bg: #FEF2F2; --bad-txt: #B91C1C; --bad-border: #F87171;\n      --good-bg: #F0F9FF; --good-txt: #0369A1; --good-border: #38BDF8;\n      --best-bg: #FEFCE8; --best-txt: #854D0E; --best-border: #FACC15;\n      --neutral-bg: #F1F5F9; --neutral-txt: #475569; --neutral-border: #94A3B8;\n      --fest-bg: #FFF7ED; --fest-txt: #C2410C; --fest-border: #FDBA74;\n      --sankalp-bg: #FFFBEB; --sankalp-border: #D97706;\n      --mark: #C2410C;\n    }\n  }\n  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }\n  html, body { margin: 0; }\n  html { background: var(--bg); }\n  body {\n    font-family: -apple-system, \"Kohinoor Devanagari\", system-ui, sans-serif;\n    background: var(--bg); color: var(--text); min-height: 100vh;\n    padding: calc(env(safe-area-inset-top) + 12px) 16px calc(env(safe-area-inset-bottom) + 24px);\n  }\n  button { font: inherit; color: inherit; }\n  header { display: flex; align-items: center; gap: 10px; }\n  .nav {\n    width: 44px; height: 44px; flex: none; border-radius: 50%; border: 1px solid var(--line);\n    background: var(--card); color: var(--saffron); font-size: 28px; line-height: 1; cursor: pointer;\n  }\n  .ttl { flex: 1; text-align: center; min-width: 0; }\n  #date { font-size: 19px; font-weight: 700; color: var(--saffron); }\n  #rel { font-size: 12.5px; color: var(--muted); }\n  .tools { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; margin: 10px 0; }\n  .pill {\n    position: relative; font-size: 13px; font-weight: 600; cursor: pointer;\n    background: var(--card); border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px;\n  }\n  .pill.lang { border-color: var(--saffron); color: var(--saffron); }\n  .hide { display: none; }\n  .pick input { position: absolute; inset: 0; opacity: 0; width: 100%; height: 100%; }\n\n  .week { display: flex; gap: 6px; margin-bottom: 12px; max-width: 900px; margin-left: auto; margin-right: auto; }\n  .wd {\n    flex: 1; min-width: 0; padding: 7px 0; border-radius: 10px; border: 1px solid var(--line);\n    background: var(--card); display: flex; flex-direction: column; align-items: center; line-height: 1.2; cursor: pointer;\n  }\n  .wd span { font-size: 11px; color: var(--muted); }\n  .wd b { font-size: 16px; }\n  .wd.today b { color: var(--saffron); }\n  .wd.sel { background: var(--saffron); border-color: var(--saffron); }\n  .wd.sel span, .wd.sel b { color: #000; }\n\n  .grid-wrap {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 14px;\n    max-width: 1180px;\n    margin: 0 auto;\n  }\n  @media (min-width: 768px) {\n    .grid-wrap {\n      grid-template-columns: 1fr 1fr;\n      align-items: start;\n    }\n  }\n\n  .card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 12px 14px; margin-bottom: 12px; }\n  .muted { color: var(--muted); font-size: 12px; }\n  .part { font-weight: 400; font-size: 12px; color: var(--muted); }\n  .nowchip {\n    display: inline-block; font-size: 10px; font-weight: 700; color: #fff; background: #D97706;\n    border-radius: 6px; padding: 1px 6px; margin-left: 4px; vertical-align: middle; white-space: nowrap;\n  }\n  .mks .nowchip { margin-left: 0; }\n\n  .best    { --t-bg: var(--best-bg);    --t-txt: var(--best-txt);    --t-bd: var(--best-border); }\n  .good    { --t-bg: var(--good-bg);    --t-txt: var(--good-txt);    --t-bd: var(--good-border); }\n  .neutral { --t-bg: var(--neutral-bg); --t-txt: var(--neutral-txt); --t-bd: var(--neutral-border); }\n  .bad     { --t-bg: var(--bad-bg);     --t-txt: var(--bad-txt);     --t-bd: var(--bad-border); }\n\n  .fest-card { background: var(--fest-bg); border: 1.5px solid var(--fest-border); }\n  .fest-list { display: flex; flex-wrap: wrap; gap: 6px; }\n  .fpill {\n    display: inline-block; background: color-mix(in srgb, var(--fest-border) 22%, transparent);\n    color: var(--fest-txt); font-weight: 700; font-size: 12px; padding: 4px 10px; border-radius: 999px;\n    border: 1px solid var(--fest-border);\n  }\n\n  .sankalp-card { background: var(--sankalp-bg); border: 1.5px solid var(--sankalp-border); }\n  .sankalp-title { font-size: 15px; font-weight: 700; color: var(--saffron); margin-bottom: 8px; }\n  .sankalp-body { font-size: 13.5px; line-height: 1.85; color: var(--text); text-align: justify; }\n  .sankalp-body b { color: var(--saffron); font-weight: 700; }\n  .sankalp-body i { font-style: italic; opacity: 0.95; }\n\n  .live {\n    display: flex; align-items: center; gap: 12px; padding: 12px 14px; margin: 0 auto 12px;\n    border-radius: 14px; background: var(--t-bg); border: 2px solid var(--t-bd); max-width: 1180px;\n  }\n  .live .lv { flex: 1; min-width: 0; display: flex; flex-direction: column; }\n  .live small { font-size: 11px; color: var(--muted); }\n  .live b { font-size: 17px; color: var(--t-txt); }\n  .live .cd { display: flex; flex-direction: column; align-items: flex-end; }\n  .live .cd b { font-size: 20px; font-variant-numeric: tabular-nums; color: var(--text); }\n\n  .ic {\n    width: 34px; height: 34px; flex: none; border-radius: 50%; display: grid; place-items: center;\n    color: var(--t-txt); background: color-mix(in srgb, var(--t-txt) 14%, transparent);\n    border: 1px solid color-mix(in srgb, var(--t-txt) 35%, transparent);\n  }\n  .ic svg { width: 18px; height: 18px; }\n\n  .tithi { display: flex; gap: 12px; align-items: flex-start; }\n  .moon { font-size: 38px; line-height: 1; padding-top: 2px; }\n  .tname { font-size: 18.5px; font-weight: 700; color: var(--saffron); }\n  .sm-mitti { font-size: 14px; color: var(--text); margin: 2px 0 1px; }\n  .sm-samvat { font-size: 12px; color: var(--muted); margin-bottom: 4px; }\n  .sun { display: flex; justify-content: space-around; font-size: 13px; color: var(--muted); margin: -2px 0 12px; }\n  .sun b { color: var(--text); }\n\n  .hd { font-weight: 700; font-size: 15px; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }\n  .hd small { font-weight: 400; font-size: 12px; opacity: .9; }\n  .sg { font-weight: 800; }\n  .big { font-size: 22px; font-weight: 700; font-variant-numeric: tabular-nums; margin-top: 2px; }\n  .rahu { background: var(--bad-bg); border: 2px solid var(--bad-border); }\n  .rahu .hd { color: var(--bad-txt); }\n  .rahu.on { box-shadow: 0 0 0 2px var(--saffron) inset; }\n  .shubh { background: var(--good-bg); border: 2px solid var(--good-border); }\n  .shubh .hd { color: var(--good-txt); margin-bottom: 4px; }\n  .win { display: grid; grid-template-columns: 18px 1fr auto; gap: 6px; align-items: center; padding: 6px 0; border-top: 1px solid color-mix(in srgb, var(--good-txt) 22%, transparent); }\n  .win .sg { color: var(--good-txt); }\n  .win .wn { font-size: 13px; color: var(--good-txt); font-weight: 600; }\n  .win .wt { font-size: 15px; font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; }\n  .win.past { opacity: .5; }\n\n  .ch-card { padding: 0; overflow: hidden; }\n  .ch-header { display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; background: var(--bg2); font-weight: 700; font-size: 14px; color: var(--saffron); border-bottom: 1px solid var(--line); }\n  .sun-time { font-size: 12px; font-weight: 400; color: var(--muted); }\n  .row {\n    display: grid; grid-template-columns: 34px minmax(0, 1fr) auto auto; align-items: center; gap: 10px;\n    padding: 9px 12px 9px 10px; border-bottom: 1px solid var(--line);\n    background: var(--t-bg); border-left: 6px solid var(--t-bd);\n  }\n  .row:last-child { border-bottom: none; }\n  .row.on { box-shadow: inset 0 0 0 2px var(--saffron); }\n  .row.past { opacity: .55; }\n  .ch-name { font-weight: 700; font-size: 15px; color: var(--t-txt); }\n  .ch-en { font-size: 11px; color: var(--muted); }\n  .mks { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 3px; }\n  .mk {\n    display: inline-flex; align-items: center; gap: 3px; font-size: 10px; font-weight: 700; color: var(--mark);\n    border: 1px solid currentColor; border-radius: 6px; padding: 0 5px; white-space: nowrap;\n  }\n  .mk svg { width: 11px; height: 11px; }\n  .tm { font-size: 13px; font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }\n  .badge {\n    font-size: 10.5px; font-weight: 700; white-space: nowrap; text-align: center; min-width: 96px;\n    color: var(--t-txt); background: color-mix(in srgb, var(--t-txt) 15%, transparent);\n    border: 1px solid color-mix(in srgb, var(--t-txt) 40%, transparent); border-radius: 999px; padding: 3px 8px;\n  }\n  @media (max-width: 370px) {\n    .row { grid-template-columns: 30px minmax(0, 1fr) auto; }\n    .row .badge { grid-column: 2 / 4; justify-self: start; min-width: 0; }\n    .ic { width: 30px; height: 30px; }\n  }\n\n  .note-card { background: var(--bg2); font-size: 12.5px; color: var(--muted); }\n  .note-card p { margin: 4px 0; }\n  .note-card b { color: var(--text); }\n\n  footer {\n    display: flex; justify-content: center; align-items: center; gap: 8px; flex-wrap: wrap;\n    margin-top: 16px; padding: 12px 16px; background: var(--card);\n    border: 1px solid var(--line); border-radius: 12px; color: var(--muted); font-size: 12px;\n    max-width: 1180px; margin-left: auto; margin-right: auto;\n  }\n  footer a { color: inherit; text-decoration: none; }\n  .logo { display: inline-flex; align-items: center; font-weight: 700; }\n  .logo img { height: 22px; width: auto; display: block; border-radius: 5px; }\n  .site { color: var(--saffron); font-weight: 600; text-decoration: underline !important; text-underline-offset: 2px; }\n</style>\n</head>\n<body>\n  <header>\n    <button class=\"nav\" id=\"prev\" aria-label=\"Previous day\">‹</button>\n    <div class=\"ttl\">\n      <div id=\"date\"></div>\n      <div id=\"rel\"></div>\n    </div>\n    <button class=\"nav\" id=\"next\" aria-label=\"Next day\">›</button>\n  </header>\n  <div class=\"tools\">\n    <button class=\"pill\" id=\"today\">Go to Today</button>\n    <label class=\"pill pick\"><span id=\"pickText\">📅 Select Date</span><input type=\"date\" id=\"picker\" aria-label=\"Select date\"></label>\n    <button class=\"pill lang\" id=\"langBtn\" aria-label=\"Switch Language\">🌐 EN-IN</button>\n  </div>\n  <nav class=\"week\" id=\"week\" aria-label=\"Choose a day\"></nav>\n  <div id=\"live\"></div>\n  <main id=\"out\"></main>\n  <footer>\n    <a class=\"logo\" href=\"${DEV_SITE}\"><img id=\"logo\" alt=\"${escapeHTML(DEV_COMPANY)}\"></a>\n    <span id=\"devBy\">Developed by ${escapeHTML(DEV_COMPANY)} ·</span>\n    <a class=\"site\" href=\"${DEV_SITE}\">www.arthsathi.com</a>\n  </footer>\n<script>\n(function (srcs) {\n  const img = document.getElementById(\"logo\");\n  let i = 0;\n  img.onerror = () => {\n    i += 1;\n    if (i < srcs.length) img.src = srcs[i];\n    else img.parentNode.remove();\n  };\n  img.src = srcs[0];\n})(${JSON.stringify(logoSources)});\ntry {\n  const panchangFactory = ${panchangLib.toString()};\n  (${dayViewPage.toString()})(\n    panchangFactory,\n    ${JSON.stringify(lang)},\n    ${Number(lat)},\n    ${Number(lon)},\n    ${JSON.stringify(placeEn || \"\")},\n    ${JSON.stringify(placeHi || \"\")},\n    ${JSON.stringify(apiPayload || null)},\n    ${JSON.stringify(API_ENDPOINT)}\n  );\n} catch (err) {\n  document.getElementById(\"out\").innerHTML = '<div class=\"card\"><p style=\"color:#FCA5A5\">Error: ' + err.message + '</p></div>';\n}\n</script>\n</body>\n</html>`;\n}\n\nasync function showDayView(lang, loc, apiPayload) {\n  const wv = new WebView();\n  wv.shouldAllowRequest = req => {\n    const url = (req && req.url) || \"\";\n    if (/^scriptable-lang:\\/\\//i.test(url)) {\n      const nextLang = url.replace(/^scriptable-lang:\\/\\//i, \"\");\n      saveLanguage(nextLang);\n      return false;\n    }\n    if (/^https?:\\/\\/(www\\.)?arthsathi\\.com(\\/|$)/i.test(url)) {\n      Safari.open(url);\n      return false;\n    }\n    return true;\n  };\n  await wv.loadHTML(dayViewHTML(lang, loc.lat, loc.lon, loc.placeEn || loc.place, loc.placeHi || loc.place, dayViewLogoSources(), apiPayload));\n  await wv.present(true);\n}\n\n// ===================== MAIN EXECUTION =====================\nasync function main() {\n  const now = new Date();\n  const lang = getSavedLanguage();\n  const P = panchangLib(lang);\n  const loc = await getLocation(lang);\n  const apiPayload = await fetchRemotePanchang(loc.lat, loc.lon, lang, now);\n\n  if (config.runsInWidget) {\n    let logo = null;\n    try { logo = await widgetLogo(); } catch (e) {}\n    const family = config.widgetFamily || \"small\";\n    const data = P.widgetData(now, loc.lat, loc.lon, apiPayload);\n    Script.setWidget(render(P, data, now, logo, family, widgetDims(family)));\n  } else {\n    await showDayView(lang, loc, apiPayload);\n    try { await widgetLogo(); } catch (e) {}\n  }\n  Script.complete();\n}\n\nawait main();",
  "share_sheet_inputs": []
}