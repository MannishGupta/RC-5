<?xml version="1.0" encoding="UTF-8"?>
<!--
  Resource Centre — SINGLE root web.config (3.2.65)
  All IIS settings live here. Nested status/web.config is removed; /status inherits this file.
  PHP upload limits are NOT controlled by web.config — use .user.ini / Plesk PHP (see app/UploadLimits.php).
-->
<configuration>
  <system.webServer>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      <remove fileExtension=".webp" /><mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" /><mimeMap fileExtension=".avif" mimeType="image/avif" />
      <remove fileExtension=".svg" /><mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".svgz" /><mimeMap fileExtension=".svgz" mimeType="image/svg+xml" />
      <remove fileExtension=".png" /><mimeMap fileExtension=".png" mimeType="image/png" />
      <remove fileExtension=".jpg" /><mimeMap fileExtension=".jpg" mimeType="image/jpeg" />
      <remove fileExtension=".jpeg" /><mimeMap fileExtension=".jpeg" mimeType="image/jpeg" />
      <remove fileExtension=".jfif" /><mimeMap fileExtension=".jfif" mimeType="image/jpeg" />
      <remove fileExtension=".gif" /><mimeMap fileExtension=".gif" mimeType="image/gif" />
      <remove fileExtension=".ico" /><mimeMap fileExtension=".ico" mimeType="image/x-icon" />
      <remove fileExtension=".cur" /><mimeMap fileExtension=".cur" mimeType="image/x-icon" />
      <remove fileExtension=".bmp" /><mimeMap fileExtension=".bmp" mimeType="image/bmp" />
      <remove fileExtension=".tif" /><mimeMap fileExtension=".tif" mimeType="image/tiff" />
      <remove fileExtension=".tiff" /><mimeMap fileExtension=".tiff" mimeType="image/tiff" />
      <remove fileExtension=".apng" /><mimeMap fileExtension=".apng" mimeType="image/apng" />
      <remove fileExtension=".jxl" /><mimeMap fileExtension=".jxl" mimeType="image/jxl" />
      <remove fileExtension=".heic" /><mimeMap fileExtension=".heic" mimeType="image/heic" />
      <remove fileExtension=".heif" /><mimeMap fileExtension=".heif" mimeType="image/heif" />
      <remove fileExtension=".json" /><mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff2" /><mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".woff" /><mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".mp4" /><mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <remove fileExtension=".webm" /><mimeMap fileExtension=".webm" mimeType="video/webm" />
      <remove fileExtension="." /><mimeMap fileExtension="." mimeType="application/octet-stream" />
    </staticContent>

    <rewrite>
      <rules>
        <rule name="RC Media Images Gateway" stopProcessing="true">
          <match url="^images/(.+)$" />
          <action type="Rewrite" url="media_serve.php?f={R:1}" appendQueryString="true" />
        </rule>
        <rule name="SitemapXML" stopProcessing="true">
          <match url="^sitemap.xml$" />
          <action type="Rewrite" url="sitemap.php" />
        </rule>
        <rule name="RobotsTxtDynamic" stopProcessing="true">
          <match url="^robots.txt$" />
          <action type="Rewrite" url="robots.php" />
        </rule>
        <rule name="Redirect Tools Directory" stopProcessing="true">
          <match url="^(monitor|optimizer|print)\.php$" />
          <action type="Redirect" url="tools/{R:1}.php" redirectType="Permanent" />
        </rule>
        <rule name="Clean Profile URL" stopProcessing="true">
          <match url="^([a-zA-Z0-9\-_]+)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(sitemap\.php|sitemap\.xml|robots\.txt|manifest\.php)$" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php?slug={R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- 50 MB — must cover Media Kit batch (80 MB needs post in chunks; single request IIS body) -->
        <requestLimits maxAllowedContentLength="52428800" maxQueryString="8192" maxUrl="8192" />
        <hiddenSegments>
          <add segment="dbd" />
          <add segment="data" />
          <add segment="tenants" />
          <add segment="app" />
          <add segment="storage" />
          <add segment="sql" />
          <add segment="tests" />
          <add segment="docs" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".json" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <remove fileExtension=".svg" />
          <add fileExtension=".svg" allowed="true" />
          <remove fileExtension=".webp" />
          <add fileExtension=".webp" allowed="true" />
          <remove fileExtension=".woff2" />
          <add fileExtension=".woff2" allowed="true" />
          <remove fileExtension=".mp4" />
          <add fileExtension=".mp4" allowed="true" />
          <remove fileExtension=".webm" />
          <add fileExtension=".webm" allowed="true" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <httpProtocol>
      <customHeaders>
        <remove name="X-UA-Compatible" />
        <add name="X-UA-Compatible" value="IE=edge" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <httpErrors existingResponse="PassThrough" />

  </system.webServer>

  <!--
    Optional path overrides (keep empty unless a sub-app needs different defaults).
    /status inherits MIME, upload size, compression, and defaultDocument from above.
  -->
  <location path="status">
    <system.webServer>
      <defaultDocument enabled="true">
        <files>
          <clear />
          <add value="index.php" />
        </files>
      </defaultDocument>
    </system.webServer>
  </location>

</configuration>
